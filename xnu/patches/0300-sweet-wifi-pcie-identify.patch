+static void
+sw_wifi_write(uint32_t pa, uint32_t value, bool *ok)
+{
+	vm_offset_t page = sw_wifi_map_page(pa);
+	if (!page) {
+		*ok = false;
+		return;
+	}
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(page + (pa & (SW_WIFI_PAGE_SIZE - 1u))) = value;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static bool
+sw_wifi_wait(uint32_t pa, uint32_t mask, uint32_t value, unsigned ms,
+    bool *ok)
+{
+	for (unsigned i = 0; i < ms && *ok; ++i) {
+		if ((sw_wifi_read(pa, ok) & mask) == value) {
+			return true;
+		}
+		IOSleep(1);
+	}
+	return *ok && (sw_wifi_read(pa, ok) & mask) == value;
+}
+
+static void
+sw_wifi_set(uint32_t pa, uint32_t mask, bool *ok)
+{
+	uint32_t value = sw_wifi_read(pa, ok);
+	if (*ok) {
+		sw_wifi_write(pa, value | mask, ok);
+	}
+}
+
+static void
+sw_wifi_clear(uint32_t pa, uint32_t mask, bool *ok)
+{
+	uint32_t value = sw_wifi_read(pa, ok);
+	if (*ok) {
+		sw_wifi_write(pa, value & ~mask, ok);
+	}
+}
+
+static uint16_t
+sw_wifi_db16(uint32_t offset, bool *ok)
+{
+	uint32_t value = sw_wifi_read(SW_WIFI_CMD_DB_PA + (offset & ~3u), ok);
+	return (uint16_t)(value >> (8u * (offset & 3u)));
+}
+
+static bool
+sw_wifi_db_range(uint32_t offset, uint32_t bytes)
+{
+	return offset <= SW_WIFI_CMD_DB_SIZE &&
+	    bytes <= SW_WIFI_CMD_DB_SIZE - offset;
+}
+
+static int
+sw_wifi_db_find(const char *name, uint32_t *address,
+    uint16_t levels[16], unsigned *level_count)
+{
+	uint32_t key[2] = {0, 0};
+	bool ok = true;
+
+	if (!name || !address || !level_count) {
+		return EINVAL;
+	}
+	if (sw_wifi_read(SW_WIFI_CMD_DB_PA + 4u, &ok) != SW_WIFI_CMD_MAGIC) {
+		return ENODEV;
+	}
+	for (unsigned i = 0; i < 8 && name[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)name[i] << (8u * (i % 4));
+	}
+	for (unsigned s = 0; s < 8 && ok; ++s) {
+		uint32_t header = 8u + 16u * s;
+		unsigned slave = sw_wifi_db16(header, &ok);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = SW_WIFI_DB_HEADER + sw_wifi_db16(header + 2u, &ok);
+		uint32_t data = SW_WIFI_DB_HEADER + sw_wifi_db16(header + 4u, &ok);
+		unsigned count = sw_wifi_db16(header + 6u, &ok);
+		if (!ok || !sw_wifi_db_range(entries, count * SW_WIFI_DB_ENTRY)) {
+			return EINVAL;
+		}
+		for (unsigned e = 0; e < count; ++e) {
+			uint32_t at = entries + e * SW_WIFI_DB_ENTRY;
+			if (sw_wifi_read(SW_WIFI_CMD_DB_PA + at, &ok) != key[0] ||
+			    sw_wifi_read(SW_WIFI_CMD_DB_PA + at + 4u, &ok) != key[1]) {
+				continue;
+			}
+			uint32_t aux_bytes = sw_wifi_db16(at + 20u, &ok);
+			uint32_t aux = data + sw_wifi_db16(at + 22u, &ok);
+			if (!ok || !sw_wifi_db_range(aux, aux_bytes)) {
+				return EINVAL;
+			}
+			*address = sw_wifi_read(SW_WIFI_CMD_DB_PA + at + 16u, &ok);
+			*level_count = 0;
+			for (unsigned i = 0; levels && i + 1u < aux_bytes &&
+			    *level_count < 16u; i += 2u) {
+				uint16_t level = sw_wifi_db16(aux + i, &ok);
+				if (*level_count && !level) {
+					break;
+				}
+				levels[(*level_count)++] = level;
+			}
+			return ok && *address ? 0 : EINVAL;
+		}
+	}
+	return ENOENT;
+}
+
+static int
+sw_wifi_level(const uint16_t levels[16], unsigned count,
+    uint32_t level, uint32_t *index)
+{
+	if (!levels || !count || !index) {
+		return EINVAL;
+	}
+	for (unsigned i = 0; i < count; ++i) {
+		if (levels[i] >= level) {
+			*index = i;
+			return 0;
+		}
+	}
+	*index = count - 1u;
+	return 0;
+}
+
+static int
+sw_wifi_vote(uint32_t address, uint32_t value)
+{
+	const uint32_t base = SW_WIFI_RSC_PA + 0xd00u +
+	    SW_WIFI_RSC_TCS * SW_WIFI_TCS_STRIDE;
+	const uint32_t bit = 1u << SW_WIFI_RSC_TCS;
+	bool ok = true, progress = false, done = false;
+	uint32_t irq_enable, irq, idle, command_status;
+
+	if (sw_wifi_rpmh_poisoned) {
+		return EIO;
+	}
+	irq_enable = sw_wifi_read(SW_WIFI_RSC_PA + SW_WIFI_IRQ_EN, &ok);
+	if (!ok || sw_wifi_read(base + SW_WIFI_STATUS, &ok) == 0 ||
+	    sw_wifi_read(base + SW_WIFI_CONTROL, &ok) != 0 ||
+	    sw_wifi_read(base + SW_WIFI_ENABLE, &ok) != 0 ||
+	    sw_wifi_read(base + SW_WIFI_WAIT, &ok) != 0 ||
+	    (sw_wifi_read(SW_WIFI_RSC_PA + SW_WIFI_IRQ_STATUS, &ok) & bit)) {
+		return EBUSY;
+	}
+	sw_wifi_rpmh_poisoned = true;
+	sw_wifi_write(SW_WIFI_RSC_PA + SW_WIFI_IRQ_EN, irq_enable & ~bit, &ok);
+	sw_wifi_write(base + SW_WIFI_CONTROL, 0, &ok);
+	sw_wifi_write(SW_WIFI_RSC_PA + SW_WIFI_IRQ_CLEAR, bit, &ok);
+	sw_wifi_write(base + SW_WIFI_MSGID, SW_WIFI_WRITE_ACK, &ok);
+	sw_wifi_write(base + SW_WIFI_ADDR, address, &ok);
+	sw_wifi_write(base + SW_WIFI_DATA, value, &ok);
+	sw_wifi_write(base + SW_WIFI_WAIT, 1, &ok);
+	sw_wifi_write(base + SW_WIFI_ENABLE, 1, &ok);
+	sw_wifi_write(base + SW_WIFI_CONTROL, SW_WIFI_AMC_EN, &ok);
+	sw_wifi_write(base + SW_WIFI_CONTROL, SW_WIFI_AMC_EN | SW_WIFI_TRIGGER, &ok);
+	for (unsigned us = 0; ok && us < SW_WIFI_TIMEOUT_US; ++us) {
+		irq = sw_wifi_read(SW_WIFI_RSC_PA + SW_WIFI_IRQ_STATUS, &ok);
+		idle = sw_wifi_read(base + SW_WIFI_STATUS, &ok);
+		command_status = sw_wifi_read(base + SW_WIFI_CMD_STATUS, &ok);
+		bool complete = (command_status & (SW_WIFI_ISSUED | SW_WIFI_COMPLETE)) ==
+		    (SW_WIFI_ISSUED | SW_WIFI_COMPLETE);
+		progress |= idle == 0 || !complete;
+		if (idle && ((irq & bit) || progress) && complete) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	if (!ok || !done) {
+		return ETIMEDOUT;
+	}
+	sw_wifi_write(base + SW_WIFI_CONTROL, SW_WIFI_AMC_EN, &ok);
+	sw_wifi_write(base + SW_WIFI_CONTROL, 0, &ok);
+	sw_wifi_write(base + SW_WIFI_ENABLE, 0, &ok);
+	sw_wifi_write(base + SW_WIFI_WAIT, 0, &ok);
+	sw_wifi_write(SW_WIFI_RSC_PA + SW_WIFI_IRQ_CLEAR, bit, &ok);
+	sw_wifi_write(SW_WIFI_RSC_PA + SW_WIFI_IRQ_EN, irq_enable, &ok);
+	if (!ok) {
+		return EIO;
+	}
+	sw_wifi_rpmh_poisoned = false;
+	return 0;
+}
+
+static int
+sw_wifi_power(void)
+{
+	static const struct {
+		const char *name;
+		uint32_t mv;
+	} rails[] = {
+		{"smpe2", 1012}, {"smpb11", 966}, {"smpb10", 1800},
+		{"smpc1", 1900}, {"smpb12", 1350}, {"ldoe7", 2800},
+		{"ldob5", 880}, {"ldoc10", 1200}
+	};
+	static const char *const arcs[] = {"cx.lvl", "mx.lvl", "xo.lvl"};
+	uint16_t levels[16];
+	uint32_t address, index;
+	unsigned count;
+	int error;
+
+	for (unsigned i = 0; i < sizeof(rails) / sizeof(rails[0]); ++i) {
+		error = sw_wifi_db_find(rails[i].name, &address, 0, &count);
+		if (!error) error = sw_wifi_vote(address + 8u, 7u);
+		if (!error) error = sw_wifi_vote(address, rails[i].mv);
+		if (!error) error = sw_wifi_vote(address + 4u, 1u);
+		if (error) return error;
+	}
+	for (unsigned i = 0; i < sizeof(arcs) / sizeof(arcs[0]); ++i) {
+		error = sw_wifi_db_find(arcs[i], &address, levels, &count);
+		index = 3u;
+		if (!error && i < 2) {
+			error = sw_wifi_level(levels, count, 0x100u, &index);
+		}
+		if (!error) error = sw_wifi_vote(address, index);
+		if (error) return error;
+	}
+	error = sw_wifi_db_find("SN7", &address, 0, &count);
+	if (!error) {
+		error = sw_wifi_vote(address,
+		    (1u << 30) | (1u << 29) | (0x400u << 14) | 0x400u);
+	}
+	return error;
+}
+
+static void
+sw_wifi_pin(unsigned gpio, uint32_t config, int level, bool *ok)
+{
+	uint32_t base = SW_WIFI_TLMM_PA + gpio * SW_WIFI_GPIO_STRIDE;
+	if (level >= 0) {
+		sw_wifi_write(base + SW_WIFI_GPIO_IO, level ? 2u : 0u, ok);
+	}
+	sw_wifi_write(base, config, ok);
+}
+
+static bool
+sw_wifi_atu(unsigned region, uint32_t type, uint32_t cpu,
+    uint32_t bytes, uint32_t target, bool *ok)
+{
+	uint32_t base = SW_WIFI_ATU_PA + region * 0x200u;
+	sw_wifi_write(base + 8u, cpu, ok);
+	sw_wifi_write(base + 12u, 0, ok);
+	sw_wifi_write(base + 16u, cpu + bytes - 1u, ok);
+	sw_wifi_write(base + 32u, 0, ok);
+	sw_wifi_write(base + 20u, target, ok);
+	sw_wifi_write(base + 24u, 0, ok);
+	sw_wifi_write(base, type, ok);
+	sw_wifi_write(base + 4u, 1u << 31, ok);
+	return *ok && sw_wifi_wait(base + 4u, 1u << 31, 1u << 31, 10, ok);
+}
+
+static int
+sw_wifi_endpoint(uint32_t *id, uint32_t *subsystem, uint32_t *bar,
+    uint32_t *bar_bytes, uint32_t *soc, uint32_t *subversion)
+{
+	bool ok = true;
+	uint32_t command, saved, mask, size, base, bhi;
+
+	if (!sw_wifi_atu(0, 4, SW_WIFI_CFG_PA, 0x100000u,
+	    SW_WIFI_CFG_TARGET, &ok)) return EIO;
+	*id = sw_wifi_read(SW_WIFI_CFG_PA, &ok);
+	*subsystem = sw_wifi_read(SW_WIFI_CFG_PA + 0x2cu, &ok);
+	if (!ok || (*id & 0xffffu) != 0x17cbu || (*id >> 16) != 0x1103u) {
+		return ENXIO;
+	}
+	command = sw_wifi_read(SW_WIFI_CFG_PA + 4u, &ok) & 0xffffu;
+	sw_wifi_write(SW_WIFI_CFG_PA + 4u, command & ~6u, &ok);
+	saved = sw_wifi_read(SW_WIFI_CFG_PA + 0x10u, &ok);
+	sw_wifi_write(SW_WIFI_CFG_PA + 0x10u, 0xffffffffu, &ok);
+	mask = sw_wifi_read(SW_WIFI_CFG_PA + 0x10u, &ok);
+	sw_wifi_write(SW_WIFI_CFG_PA + 0x10u, saved, &ok);
+	size = ~(mask & ~15u) + 1u;
+	if (!ok || (mask & 1u) || !(mask & ~15u) || !size ||
+	    size > 0x02000000u) return EINVAL;
+	base = (SW_WIFI_BAR_BASE + size - 1u) & ~(size - 1u);
+	if (base + size > SW_WIFI_BAR_LIMIT ||
+	    !sw_wifi_atu(1, 0, base, size, base, &ok)) return EINVAL;
+	sw_wifi_write(SW_WIFI_DBI_PA + 0x20u,
+	    ((base + size - 1u) & 0xfff00000u) |
+	    ((base >> 16) & 0xfff0u), &ok);
+	sw_wifi_write(SW_WIFI_CFG_PA + 0x10u, base | (saved & 15u), &ok);
+	if ((mask & 6u) == 4u) sw_wifi_write(SW_WIFI_CFG_PA + 0x14u, 0, &ok);
+	sw_wifi_write(SW_WIFI_CFG_PA + 4u, (command & ~4u) | 2u, &ok);
+	*bar = sw_wifi_read(SW_WIFI_CFG_PA + 0x10u, &ok);
+	*bar_bytes = size;
+	*soc = sw_wifi_read(base + 0x224u, &ok);
+	bhi = sw_wifi_read(base + 0x28u, &ok);
+	(void)bhi;
+	uint32_t window = sw_wifi_read(base + 0x310cu, &ok);
+	sw_wifi_write(base + 0x310cu,
+	    (1u << 30) | ((0x1910010u >> 19) & 0x3fu), &ok);
+	*subversion = sw_wifi_read(base + 0x80000u +
+	    (0x1910010u & 0x7ffffu), &ok);
+	sw_wifi_write(base + 0x310cu, window, &ok);
+	return ok ? 0 : ENOMEM;
+}
+
+static int
+sw_wifi_phase2(int stage)
+{
+	bool ok = true;
+	uint32_t id = 0, subsystem = 0, bar = 0, bytes = 0, soc = 0, sub = 0;
+	int error = sw_wifi_power();
+	if (error) return error;
+
+	sw_wifi_pin(94, 1u | (1u << 9), 0, &ok);
+	sw_wifi_pin(95, 3u | (1u << 2), -1, &ok);
+	sw_wifi_pin(80, 3u | (7u << 6) | (1u << 9), 0, &ok);
+	IOSleep(150);
+	sw_wifi_pin(204, 1u << 9, 1, &ok);
+	IODelay(200);
+	sw_wifi_pin(80, 3u | (7u << 6) | (1u << 9), 1, &ok);
+	IOSleep(4);
+	sw_wifi_pin(204, 1u << 9, 0, &ok);
+	IOSleep(60);
+
+	sw_wifi_clear(SW_WIFI_GCC_PA + 0x62128u, 1u, &ok);
+	if (!sw_wifi_wait(SW_WIFI_GCC_PA + SW_WIFI_GDSC,
+	    1u << 31, 1u << 31, 10, &ok)) return ETIMEDOUT;
+	sw_wifi_write(SW_WIFI_GCC_PA + 0x7b068u, 0, &ok);
+	sw_wifi_set(SW_WIFI_GCC_PA + 0x7b064u, 1u, &ok);
+	sw_wifi_write(SW_WIFI_GCC_PA + 0x7b04cu, 0, &ok);
+	sw_wifi_set(SW_WIFI_GCC_PA + 0x7b048u, 1u, &ok);
+	if (!sw_wifi_wait(SW_WIFI_GCC_PA + 0x7b064u, 1u, 0, 10, &ok) ||
+	    !sw_wifi_wait(SW_WIFI_GCC_PA + 0x7b048u, 1u, 0, 10, &ok)) {
+		return ETIMEDOUT;
+	}
+	uint32_t rate = sw_wifi_read(SW_WIFI_GCC_PA + 0x7b060u, &ok);
+	sw_wifi_write(SW_WIFI_GCC_PA + 0x7b060u, (rate & ~3u) | 2u, &ok);
+	sw_wifi_set(SW_WIFI_GCC_PA + 0x62008u, 0x3fu, &ok);
+	sw_wifi_set(SW_WIFI_GCC_PA + 0x62000u,
+	    (1u << 11) | (1u << 12) | (1u << 19) | (1u << 22), &ok);
+	sw_wifi_set(SW_WIFI_GCC_PA + 0x9c004u, 1u, &ok);
+	IOSleep(1);
+	if (!ok || (sw_wifi_halted(&ok) & 0x2fu)) return EIO;
+	static const uint32_t resets[] = {0x7b000u, 0x7c01cu};
+	for (unsigned i = 0; i < sizeof(resets) / sizeof(resets[0]); ++i) {
+		sw_wifi_set(SW_WIFI_GCC_PA + resets[i], 1u, &ok);
+		IODelay(1000);
+		sw_wifi_clear(SW_WIFI_GCC_PA + resets[i], 1u, &ok);
+		IODelay(1000);
+	}
+
+	sw_wifi_write(SW_WIFI_PARF_PA + 0x1000u, 4u, &ok);
+	sw_wifi_clear(SW_WIFI_PARF_PA + 0x40u, 1u, &ok);
+	sw_wifi_write(SW_WIFI_PARF_PA + 0x350u, 0, &ok);
+	sw_wifi_write(SW_WIFI_PARF_PA, 0x365eu, &ok);
+	sw_wifi_set(SW_WIFI_PARF_PA + 0x174u, 1u << 4, &ok);
+	sw_wifi_write(SW_WIFI_PARF_PA + 0x358u, 0x04000000u, &ok);
+	sw_wifi_set(SW_WIFI_PARF_PA + 0x1a8u, 1u << 31, &ok);
+	for (unsigned i = 0;
+	    i < sizeof(sw_wifi_phy) / sizeof(sw_wifi_phy[0]); ++i) {
+		sw_wifi_write(SW_WIFI_PHY_PA + sw_wifi_phy[i].offset,
+		    sw_wifi_phy[i].value, &ok);
+		if (sw_wifi_phy[i].delay_us) IODelay(sw_wifi_phy[i].delay_us);
+	}
+	sw_wifi_clear(SW_WIFI_GCC_PA + 0x7b060u, 3u, &ok);
+	if (!sw_wifi_wait(SW_WIFI_PHY_PA + 0x214u, 1u << 6, 0, 100, &ok)) {
+		return ETIMEDOUT;
+	}
+	for (unsigned i = 0; i < 256; ++i) {
+		sw_wifi_write(SW_WIFI_PARF_PA + 0x2000u + 4u * i, 0, &ok);
+	}
+	uint8_t hash = 0;
+	static const uint8_t requester[] = {1, 0};
+	for (unsigned i = 0; i < sizeof(requester); ++i) {
+		hash ^= requester[i];
+		for (unsigned bit = 0; bit < 8; ++bit) {
+			hash = (hash & 0x80) ? (uint8_t)((hash << 1) ^ 7) :
+			    (uint8_t)(hash << 1);
+		}
+	}
+	sw_wifi_write(SW_WIFI_PARF_PA + 0x2000u + 4u * hash,
+	    (0x100u << 16) | (1u << 8), &ok);
+	sw_wifi_clear(SW_WIFI_PARF_PA + 0x2c00u, 1u, &ok);
+	sw_wifi_write(SW_WIFI_DBI_PA + 0x18u, 0x10100u, &ok);
+	uint32_t command = sw_wifi_read(SW_WIFI_DBI_PA + 4u, &ok);
+	sw_wifi_write(SW_WIFI_DBI_PA + 4u, (command & 0xffffu) | 6u, &ok);
+	uint32_t speed = sw_wifi_read(SW_WIFI_DBI_PA + 0xa0u, &ok);
+	sw_wifi_write(SW_WIFI_DBI_PA + 0xa0u, (speed & ~15u) | 2u, &ok);
+	IOSleep(100);
+	sw_wifi_pin(94, 1u | (1u << 9), 1, &ok);
+	IOSleep(10);
+	sw_wifi_set(SW_WIFI_PARF_PA + 0x1b0u, 1u << 8, &ok);
+	if (!sw_wifi_wait(SW_WIFI_DBI_PA + 0x80u,
+	    1u << 29, 1u << 29, 1000, &ok)) return ETIMEDOUT;
+	error = sw_wifi_endpoint(&id, &subsystem, &bar, &bytes, &soc, &sub);
+	if (error) return error;
+	printf(SW_WIFI_PCIE_MARKER "\n",
+	    stage, id, subsystem, bar, bytes, soc, sub);
+	sweet_log_sync();
+	return 0;
+}
