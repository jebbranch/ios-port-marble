new file mode 100644
index 0000000..2e2283f
--- /dev/null
+++ b/iokit/Kernel/arm/hid/SweetAudioProbe.cpp
@@ -0,0 +1,498 @@
+/*
+ * SWEET: an empty audio service, published under the names iOS's audio userspace
+ * looks up, whose only job is to report whether anyone opens it.
+ *
+ * Why this file exists: the audio path through the DSP is already working
+ * (GRAPH_OPEN/PREPARE/START and DATA_BUFFER_DONE status=0 against our own shared
+ * memory), but every byte that reaches it is synthesised here in the kernel.  An
+ * iOS app cannot make a sound until something in the kernel answers the name its
+ * audio server goes looking for.  Two facts make this worth a single boot rather
+ * than a research project:
+ *
+ *   - our own booted kernel contains no Apple audio class at all
+ *     (out/kernel.adsp: IOAudio2Device, IOAudio2DeviceUserClient,
+ *     AppleAOPAudioController, AppleEmbeddedAudioDevice all absent), and the tree
+ *     we compile has no "class IOAudio2Device" and no audio source in
+ *     iokit/conf/files.arm64 - so taking these names cannot collide at link time;
+ *   - the same trick already demonstrably works for haptics: the services
+ *     published by iokit/Kernel/arm/hid/SweetHaptics.cpp are opened by
+ *     backboardd (pid 57) ~99 times per boot, with map and selector calls
+ *     following.  Publishing an Apple-named IOService is not a guess here, it is
+ *     a measured path.
+ *
+ * What this step asks is one binary question: does mediaserverd (or anything
+ * else on the audio side) call IOServiceOpen on these names?  Everything here is
+ * therefore inert - no PCM, no GLINK, no GPIO, nothing plays and nothing can
+ * hang.  It is also off unless asked for: without sweetaudioprobe=1 the classes
+ * never call registerService(), so a boot that does not want this experiment is
+ * byte-for-byte the boot it had before.
+ *
+ * Unknown selectors are acknowledged with zeroed outputs so that a client that
+ * does get as far as issuing calls keeps going and we capture the whole
+ * sequence - the same reason the haptics probe does it.
+ */
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSSymbol.h>
+#include <libkern/c++/OSCollectionIterator.h>
+#include <kern/task.h>
+
+/* kern/boot_params.h is not on this file's include path (it failed CI that way),
+ * so declare the one kernel entry point we need, the way SweetHaptics.cpp declares
+ * sweet_haptics_kick(). */
+extern "C" int PE_parse_boot_argn(const char *name, void *value, int length);
+
+#define SWEET_AUDIO_OPEN_LIMIT 8
+
+static bool
+sweet_audio_probe_enabled(void)
+{
+	static int cached = -1;
+
+	if (cached < 0) {
+		int on = 0;
+		int exp = 0;
+
+		(void)PE_parse_boot_argn("sweetaudioprobe", &on, sizeof(on));
+		/*
+		 * sweetexp is the aggregate instrument switch: this kernel's boot-args
+		 * field is 607 bytes (mkpayload.py:36,37,186 - CMDLINE 0x48 plus
+		 * BOOT_LINE_LENGTH 608 ending at SEG_TABLE 0x2a8) and the packer used to
+		 * slice whatever did not fit, silently.  Sharing one integer argument
+		 * between instruments means a new witness costs no cmdline bytes; bit 1
+		 * is this probe, bit 0 is the IBAT burst in bsd/dev/sweet_glink.c.
+		 */
+		(void)PE_parse_boot_argn("sweetexp", &exp, sizeof(exp));
+		if (!on && (exp & 0x2) != 0) {
+			on = 1;
+		}
+		/*
+		 * Printed after parsing, and every boot.  An instrument that cannot
+		 * report its own absence is not an instrument: 0244 v1 printed nothing at
+		 * all and the silence could not be told apart from "the patch did not
+		 * apply" or "the boot-arg never arrived" - and in fact the argument had
+		 * been dropped, because sweetaudioprobe=1 sat at byte 629 of a 607-byte
+		 * field.  So gate flag=0 means the argument did not reach the kernel,
+		 * which is a void run and not a negative result.
+		 */
+		IOLog("SWEET AUDPROBE: gate flag=%d exp=%#x\n", on, exp);
+		cached = on ? 1 : 0;
+	}
+	return cached == 1;
+}
+
+static void
+sweet_audio_props(IOService *service, OSObject *properties)
+{
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	OSCollectionIterator *it;
+
+	if (dict == NULL) {
+		IOLog("SWEET AUDPROBE: %s setProperties (non-dict)\n",
+		    service->getName());
+		return;
+	}
+	it = OSCollectionIterator::withCollection(dict);
+	if (it == NULL) {
+		return;
+	}
+	IOLog("SWEET AUDPROBE: %s setProperties count=%u\n", service->getName(),
+	    (unsigned)dict->getCount());
+	OSObject *key;
+	while ((key = it->getNextObject()) != NULL) {
+		const OSSymbol *sym = OSDynamicCast(OSSymbol, key);
+
+		IOLog("SWEET AUDPROBE:   prop %s\n",
+		    sym ? sym->getCStringNoCopy() : "?");
+	}
+	it->release();
+}
+
+/*
+ * Shared user client.  initWithTask is the answer to the question this file
+ * exists to ask, so the process is identified by pid and, where the kernel can
+ * see it, by name; everything else just records what the client tried.
+ */
+class SweetAudioUCBase : public IOUserClient {
+	OSDeclareDefaultStructors(SweetAudioUCBase);
+public:
+	virtual bool initWithTask(task_t owningTask, void *securityID,
+	    UInt32 type, OSDictionary *properties) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn externalMethod(uint32_t selector,
+	    IOExternalMethodArguments *arguments,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientDied(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn registerNotificationPort(mach_port_t port, UInt32 type,
+	    UInt32 refCon) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientMemoryForType(UInt32 type,
+	    IOOptionBits *options, IOMemoryDescriptor **memory)
+	    APPLE_KEXT_OVERRIDE;
+protected:
+	/* subclasses log who they are serving (see IOAudio2DeviceUserClient) */
+	int fPid;
+};
+
+OSDefineMetaClassAndStructors(SweetAudioUCBase, IOUserClient);
+
+bool
+SweetAudioUCBase::initWithTask(task_t owningTask, void *securityID,
+    UInt32 type, OSDictionary *properties)
+{
+	fPid = owningTask ? task_pid(owningTask) : -1;
+	if (!IOUserClient::initWithTask(owningTask, securityID, type,
+	    properties)) {
+		return false;
+	}
+	IOLog("SWEET AUDPROBE: %s open by pid %d type %#x\n", getName(), fPid,
+	    (unsigned)type);
+	return true;
+}
+
+IOReturn
+SweetAudioUCBase::externalMethod(uint32_t selector,
+    IOExternalMethodArguments *arguments, IOExternalMethodDispatch *dispatch,
+    OSObject *target, void *reference)
+{
+	if (arguments == NULL) {
+		IOLog("SWEET AUDPROBE: %s sel=%u arguments==NULL\n", getName(),
+		    (unsigned)selector);
+		return kIOReturnBadArgument;
+	}
+	IOLog("SWEET AUDPROBE: %s sel=%u sin=%u sout=%u struct_in=%u "
+	    "struct_out=%u\n", getName(), (unsigned)selector,
+	    (unsigned)arguments->scalarInputCount,
+	    (unsigned)arguments->scalarOutputCount,
+	    (unsigned)arguments->structureInputSize,
+	    (unsigned)arguments->structureOutputSize);
+
+	if (dispatch == NULL) {
+		for (uint32_t i = 0; i < arguments->scalarInputCount &&
+		    i < SWEET_AUDIO_OPEN_LIMIT && arguments->scalarInput != NULL;
+		    i++) {
+			IOLog("SWEET AUDPROBE:   in[%u]=%#llx\n", i,
+			    (unsigned long long)arguments->scalarInput[i]);
+		}
+		for (uint32_t i = 0; i < arguments->scalarOutputCount &&
+		    i < SWEET_AUDIO_OPEN_LIMIT && arguments->scalarOutput != NULL;
+		    i++) {
+			arguments->scalarOutput[i] = 0;
+		}
+	}
+	/*
+	 * Hand the call over instead of answering kIOReturnSuccess here.  Two
+	 * reasons, both learned from Apple's own implementation in the iPhone X
+	 * kernel (artifacts/kernel.bin, Darwin 22.3.0 xnu-8792.82.2~1/
+	 * RELEASE_ARM64_T8015):
+	 *
+	 *   - IOUserClient's base (validator around 0xfffffff0077fca18) compares
+	 *     dispatch->checkScalarInputCount / checkStructureInputSize against the
+	 *     client's arguments and returns kIOReturnBadArgument (0xe00002c2) on a
+	 *     mismatch.  A blanket Success would answer "yes" to calls Apple answers
+	 *     "no" to, so the client's state machine we are trying to observe would
+	 *     not behave like it does on a real phone.
+	 *   - worse, Success with an UNFILLED structureOutput is a lie a client can
+	 *     read as data.  An error is survivable; garbage is not.
+	 *
+	 * With dispatch == NULL the base runs no method and reports it as
+	 * unsupported, which is exactly what Apple's user clients do for selectors
+	 * past their table - so our log keeps being a capability map.
+	 */
+	return IOUserClient::externalMethod(selector, arguments, dispatch, target,
+	    reference);
+}
+
+IOReturn
+SweetAudioUCBase::registerNotificationPort(mach_port_t port, UInt32 type,
+    UInt32 refCon)
+{
+	IOLog("SWEET AUDPROBE: %s notify port type=%#x ref=%#x\n", getName(),
+	    (unsigned)type, (unsigned)refCon);
+	return IOUserClient::registerNotificationPort(port, type, refCon);
+}
+
+IOReturn
+SweetAudioUCBase::clientMemoryForType(UInt32 type, IOOptionBits *options,
+    IOMemoryDescriptor **memory)
+{
+	IOBufferMemoryDescriptor *buf;
+
+	IOLog("SWEET AUDPROBE: %s map requested type=%u options=%#x\n",
+	    getName(), (unsigned)type, options ? (unsigned)*options : 0);
+
+	/*
+	 * It used to refuse every type, "we only want to know that it asked", and
+	 * that is exactly what the first boot with this probe showed us it was not
+	 * enough for: ring-ep.txt has mediaserverd (pid 28, confirmed at :1681)
+	 * opening the AOP user client at :954, running selector 0 at :957, asking
+	 * for type 0 at :958 - refused - then closing at :959 and dying at :960;
+	 * the IOAudio2Device client at :1367 asked for type 0 at :1368 and never got
+	 * as far as a selector.  Ordering is not proof of cause and I am not claiming
+	 * it, but a probe that answers "unsupported" to the one thing every client
+	 * asks cannot see past that point, so type 0 now gets a buffer.
+	 *
+	 * Other types stay refused, so the log still shows what else it wants.
+	 */
+	if (type != 0 || memory == NULL || !sweet_audio_probe_enabled()) {
+		IOLog("SWEET AUDPROBE: %s map refused type=%u\n", getName(),
+		    (unsigned)type);
+		return kIOReturnUnsupported;
+	}
+	/*
+	 * The same call 0197/0211 have been shipping for the haptics client
+	 * (IOBufferMemoryDescriptor::withCapacity(0x10000, kIODirectionInOut, true))
+	 * - reused deliberately, because that idiom is already proven to build and
+	 * to survive a client mapping it here; withCapacity also hands the reference
+	 * to the caller without an extra release, which is what this API expects.
+	 */
+	buf = IOBufferMemoryDescriptor::withCapacity(0x10000, kIODirectionInOut,
+	    true);
+	if (buf == NULL) {
+		IOLog("SWEET AUDPROBE: %s map type=0 no memory\n", getName());
+		return kIOReturnNoMemory;
+	}
+	*memory = buf;
+	IOLog("SWEET AUDPROBE: %s map type=0 handed 0x10000 zeros\n",
+	    getName());
+	return kIOReturnSuccess;
+}
+
+IOReturn
+SweetAudioUCBase::clientClose(void)
+{
+	IOLog("SWEET AUDPROBE: %s closed (pid %d)\n", getName(), fPid);
+	return IOUserClient::clientClose();
+}
+
+IOReturn
+SweetAudioUCBase::clientDied(void)
+{
+	IOLog("SWEET AUDPROBE: %s died (pid %d)\n", getName(), fPid);
+	return IOUserClient::clientDied();
+}
+
+/*
+ * The two names worth asking about first, both taken from a real D22AP ioreg
+ * dump (work/iphone-x-recon/dyld/ioservice.txt, kernel xnu-8792.82.2, build
+ * 20D67), not from memory:
+ *
+ *   ioservice.txt:3545  +-o AppleAOPAudioController <class
+ *                     IORegistryEntry:IOService:AppleBaseAudioController:
+ *                     AppleAOPAudioController>
+ *   ioservice.txt:3559  "IOUserClientClass" = "AppleAOPAudioUserClient"
+ *   ioservice.txt:3569  "IOMatchCategory"    = "AppleAOPAudioController"
+ *   ioservice.txt:13112 "device UID"         = "Speaker"
+ *
+ * The controller is the IOProviderClass that the rootfs's own HAL bundle
+ * declares it needs (/System/Library/Audio/Plug-Ins/HAL/AppleAOPAudioPlugin
+ * .driver), so if the iOS audio server walks any IOKit path it passes through
+ * this one.  The user-client class names have to match exactly, because that
+ * string is what IOService::open() looks up; an earlier draft of this file
+ * invented "AppleAOPAudioControllerUC"/"IOAudio2DeviceUC" and
+ * "IOAudio2DeviceUID", and "IOAudio2DeviceUID" has zero occurrences in the
+ * real dump - the property carrying the UID is literally named "device UID".
+ */
+/*
+ * AppleAOPAudioUserClient's method table, transcribed from Apple's own
+ * implementation rather than invented.  In artifacts/kernel.bin (Darwin 22.3.0,
+ * xnu-8792.82.2~1/RELEASE_ARM64_T8015 - the same build as the ioreg dump) its
+ * externalMethod computes a dispatch pointer as table + selector * 0x18, bounds
+ * it against 6, and tail-calls IOUserClient::externalMethod.  0x18 is
+ * sizeof(IOExternalMethodDispatch) (iokit/IOKit/IOUserClient.h:160-166), and the
+ * six records are named method_Open, method_Close, method_StartHardware,
+ * method_StopHardware, method_GetControlValue, method_SetControlValue, with
+ * {checkScalarInputCount, checkStructureInputSize, checkScalarOutputCount,
+ * checkStructureOutputSize} = {0,0,0,0} for the first four, {1,0,1,0} and
+ * {2,0,0,0} for the last two.
+ *
+ * Copying the widths is the point: with them, a client asking selector 4 with no
+ * scalar input gets the same kIOReturnBadArgument Apple would send, and a
+ * selector past 5 gets unsupported - so what lands in the ring is a map of what
+ * the audio stack actually calls, not an artefact of a shell that accepts
+ * everything.
+ */
+#define SWEET_AOP_METHOD_COUNT 6
+
+static IOReturn
+sweet_aop_method(OSObject *target, void *reference,
+    IOExternalMethodArguments *arguments)
+{
+	uint32_t sel = (uint32_t) (uintptr_t) reference;
+	uint32_t i;
+
+	if (arguments == NULL) {
+		return kIOReturnBadArgument;
+	}
+	for (i = 0; i < arguments->scalarOutputCount && arguments->scalarOutput != NULL; i++) {
+		arguments->scalarOutput[i] = 0;
+	}
+	IOLog("SWEET AUDPROBE: aop sel=%u ran in=%u out=%u sin=%#llx\n", sel,
+	    (unsigned) arguments->scalarInputCount,
+	    (unsigned) arguments->scalarOutputCount,
+	    (arguments->scalarInput != NULL && arguments->scalarInputCount > 0) ?
+	    (unsigned long long) arguments->scalarInput[0] : 0ull);
+	return kIOReturnSuccess;
+}
+
+static IOExternalMethodDispatch sAopMethods[SWEET_AOP_METHOD_COUNT] = {
+	{ sweet_aop_method, 0, 0, 0, 0 },   /* method_Open             */
+	{ sweet_aop_method, 0, 0, 0, 0 },   /* method_Close            */
+	{ sweet_aop_method, 0, 0, 0, 0 },   /* method_StartHardware    */
+	{ sweet_aop_method, 0, 0, 0, 0 },   /* method_StopHardware     */
+	{ sweet_aop_method, 1, 0, 1, 0 },   /* method_GetControlValue  */
+	{ sweet_aop_method, 2, 0, 0, 0 },   /* method_SetControlValue  */
+};
+
+class AppleAOPAudioUserClient : public SweetAudioUCBase {
+	OSDeclareDefaultStructors(AppleAOPAudioUserClient);
+public:
+	virtual IOReturn externalMethod(uint32_t selector,
+	    IOExternalMethodArguments *arguments,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(AppleAOPAudioUserClient, SweetAudioUCBase);
+
+IOReturn
+AppleAOPAudioUserClient::externalMethod(uint32_t selector,
+    IOExternalMethodArguments *arguments, IOExternalMethodDispatch *dispatch,
+    OSObject *target, void *reference)
+{
+	if (dispatch == NULL && selector < SWEET_AOP_METHOD_COUNT) {
+		dispatch = &sAopMethods[selector];
+		target = this;
+		reference = (void *) (uintptr_t) selector;
+	}
+	return SweetAudioUCBase::externalMethod(selector, arguments, dispatch,
+	    target, reference);
+}
+
+class AppleAOPAudioController : public IOService {
+	OSDeclareDefaultStructors(AppleAOPAudioController);
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(AppleAOPAudioController, IOService);
+
+bool
+AppleAOPAudioController::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	/*
+	 * Unconditional, and ahead of the gate: this is the "did 0244 actually link
+	 * and did the platform kext publish my class" half of the three-state
+	 * diagnosis.  No line at all = the patch is not in this kernel; line without
+	 * "registered" = the arg did not arrive; both lines = the probe is live.
+	 */
+	IOLog("SWEET AUDPROBE: AppleAOPAudioController start\n");
+	if (!sweet_audio_probe_enabled()) {
+		return true;
+	}
+	setProperty("IOUserClientClass", "AppleAOPAudioUserClient");
+	setProperty("IOMatchCategory", "AppleAOPAudioController");
+	registerService();
+	IOLog("SWEET AUDPROBE: AppleAOPAudioController registered\n");
+	return true;
+}
+
+IOReturn
+AppleAOPAudioController::setProperties(OSObject *properties)
+{
+	sweet_audio_props(this, properties);
+	return kIOReturnSuccess;
+}
+
+/*
+ * IOAudio2DeviceUserClient is the class that actually carries audio clients: in
+ * the iPhone X dump it has 8 live instances against AppleAOPAudioUserClient's 1
+ * (ioservice.txt, IOUserClient:IOAudio2DeviceUserClient nodes at :10572, :12913,
+ * :13021, :13131, :13310, :13420, :13495, :13607).
+ *
+ * Apple's version has NO selector table of its own: its externalMethod and
+ * clientMemoryForType are trampolines into the owning device, and
+ * getTargetAndMethodForIndex / getTargetAndTrapForIndex read counts that belong
+ * to the IOAudio2Device subclass (this+0x100 / this+0x104 in the binary).  A
+ * client using the legacy IOConnectMethod* / trap path asks those two BEFORE it
+ * ever issues a selector, so if it gives up there the open-only log would show a
+ * connection with no methods and nothing to explain it.  Log the index, return
+ * NULL the way an empty table does.
+ */
+class IOAudio2DeviceUserClient : public SweetAudioUCBase {
+	OSDeclareDefaultStructors(IOAudio2DeviceUserClient);
+public:
+	virtual IOExternalMethod * getTargetAndMethodForIndex(
+	    IOService **targetP, UInt32 index) APPLE_KEXT_OVERRIDE;
+	virtual IOExternalTrap * getTargetAndTrapForIndex(
+	    IOService **targetP, UInt32 index) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(IOAudio2DeviceUserClient, SweetAudioUCBase);
+
+IOExternalMethod *
+IOAudio2DeviceUserClient::getTargetAndMethodForIndex(IOService **targetP,
+    UInt32 index)
+{
+	IOLog("SWEET AUDPROBE: legacy method[%u] requested by pid %d\n",
+	    (unsigned) index, fPid);
+	if (targetP != NULL) {
+		*targetP = NULL;
+	}
+	return NULL;
+}
+
+IOExternalTrap *
+IOAudio2DeviceUserClient::getTargetAndTrapForIndex(IOService **targetP,
+    UInt32 index)
+{
+	IOLog("SWEET AUDPROBE: legacy trap[%u] requested by pid %d\n",
+	    (unsigned) index, fPid);
+	if (targetP != NULL) {
+		*targetP = NULL;
+	}
+	return NULL;
+}
+
+class IOAudio2Device : public IOService {
+	OSDeclareDefaultStructors(IOAudio2Device);
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(IOAudio2Device, IOService);
+
+bool
+IOAudio2Device::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	IOLog("SWEET AUDPROBE: IOAudio2Device start\n");
+	if (!sweet_audio_probe_enabled()) {
+		return true;
+	}
+	setProperty("IOUserClientClass", "IOAudio2DeviceUserClient");
+	/*
+	 * "device UID" - with a space - is the property the real Speaker node carries
+	 * (ioservice.txt:13112).  The names this draft had before, IOAudio2DeviceUID
+	 * plus invented manufacturer/model strings, do not appear anywhere in the
+	 * dump, so they are dropped rather than kept as decoration.
+	 */
+	setProperty("device UID", "Speaker");
+	registerService();
+	IOLog("SWEET AUDPROBE: IOAudio2Device Speaker registered\n");
+	return true;
+}
+
+IOReturn
+IOAudio2Device::setProperties(OSObject *properties)
+{
+	sweet_audio_props(this, properties);
+	return kIOReturnSuccess;
+}
