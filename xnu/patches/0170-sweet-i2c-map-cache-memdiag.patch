+/* ml_io_map never unmaps, so keep one mapping per pad instead of leaking a
+ * new kernel_map entry on every probe-time level read. */
+static vm_offset_t
+sw_pad_map(uint32_t pa)
+{
+	static struct {
+		uint32_t pa;
+		vm_offset_t va;
+	} cache[8];
+	static int n;
+
+	for (int i = 0; i < n; i++) {
+		if (cache[i].pa == pa) {
+			return cache[i].va;
+		}
+	}
+	if (n >= 8) {
+		return 0;
+	}
+	cache[n].va = ml_io_map(pa, 0x1000u);
+	cache[n].pa = pa;
+	if (!cache[n].va) {
+		return 0;
+	}
+	n++;
+	return cache[n - 1].va;
+}
