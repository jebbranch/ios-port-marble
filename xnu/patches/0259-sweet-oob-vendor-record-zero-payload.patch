+				printf("SWEET MARK: oobcfg v7 recs not read back (past the mapping)\n");
 				sweet_log_sync();
 				continue;
 			}
@@ -5595,7 +5591,7 @@ g_apm_set_cfg_oob(uint32_t src_port, const char *what)
 				const uint8_t *rec = (const uint8_t *)g_shm_va +
 				    oob_off + i * SWEET_OOB_STRIDE;
 
-				printf("SWEET MARK: oobcfg v6 rec %u iid=%#x param=%#x size=%u err=%#x\n",
