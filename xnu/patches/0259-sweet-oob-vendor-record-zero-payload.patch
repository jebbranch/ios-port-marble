@@ -5483,21 +5483,19 @@ g_apm_set_cfg(uint32_t src_port, uint32_t mod_iid, uint32_t pid,
  */
 static const uint32_t g_oob_offs[] = { 0x1000u };
 #define SWEET_OOB_FORMS 1		/* 0 = bare offset, 1 = base + offset */
-#define SWEET_OOB_RECS  9
-#define SWEET_OOB_STRIDE 32		/* 16-byte wire header + align8(12) */
+#define SWEET_OOB_RECS  4
+#define SWEET_OOB_STRIDE 72		/* 16-byte wire header + align8(52) */
 
 /*
- * I round: H moved three sub-variables at once (param id, per-record size with its
- * stride and count, and the payload bytes) and status answered 0x3 instead of 0x1.
- * I changes only the param id - same nine records, same size 12, same 32-byte
- * stride, same payload words, same address 0x1000, same dst and handle as G - so
- * the answer says whether the 0x1/0x3 boundary is the id or the size/payload.
+ * J round: I answered 0x1, so the param id alone is not what moved H from 0x1 to
+ * 0x3 - what is left is the per-record size (with its stride and record count) and
+ * the payload bytes.  J holds H exactly - iid=1, param 0x08001004, size 52, four
+ * records, stride 72, total 288, address 0x1000, dst=1, same handle - and zeroes
+ * only the payload bytes.  0x3 would mean the body content is irrelevant and the
+ * size/stride is the boundary; 0x1 would mean APM or the module inspects the bytes
+ * themselves, which makes payload content a climbable axis.
  */
-static const uint32_t g_oob_miids[SWEET_OOB_RECS] = {
-	0x428fu, 0x40bdu, 0x42d3u,		/* present in our graph: control */
-	0x40bfu, 0x40c0u, 0x40c8u, 0x4165u, 0x4308u,	/* never seen in our container */
-	0x428fu		/* repeated control: 9 records x 32 = 288 > the 256 in-band cap */
-};
+static const uint32_t g_oob_miids[SWEET_OOB_RECS] = { 1u, 1u, 1u, 1u };
 
 static int
 g_apm_set_cfg_oob(uint32_t src_port, const char *what)
@@ -5509,7 +5507,7 @@ g_apm_set_cfg_oob(uint32_t src_port, const char *what)
