-		printf("SWEET MARK: oobcfg v6 no mapping\n");
+		printf("SWEET MARK: oobcfg v7 no mapping\n");
 		return (-1);
 	}
 	memset(body, 0, sizeof(body));
@@ -5518,11 +5516,9 @@ g_apm_set_cfg_oob(uint32_t src_port, const char *what)
 	for (i = 0; i < SWEET_OOB_RECS; i++) {
 		g_put32(body + off + 0, g_oob_miids[i]);
 		g_put32(body + off + 4, 0x08001004u);
-		g_put32(body + off + 8, 12);
+		g_put32(body + off + 8, 52);
 		g_put32(body + off + 12, 0);	/* error_code, written by the DSP */
-		g_put32(body + off + 16, 96000);
-		g_put32(body + off + 20, 0x30020);
-		g_put32(body + off + 24, 1);
+		/* payload bytes left zeroed on purpose: the only thing J changes vs H */
 		off += SWEET_OOB_STRIDE;
 	}
 	for (t = 0; t < sizeof(g_oob_offs) / sizeof(g_oob_offs[0]); t++) {
@@ -5531,7 +5527,7 @@ g_apm_set_cfg_oob(uint32_t src_port, const char *what)
 		uint32_t f;
 
 		if (!in_bounds) {
-			printf("SWEET MARK: oobcfg v6 off=%#x is past the declared region %#x, body not written\n",
+			printf("SWEET MARK: oobcfg v7 off=%#x is past the declared region %#x, body not written\n",
 			    oob_off, g_shm_region_size());
 		} else {
 			memcpy((void *)(g_shm_va + oob_off), body, off);
@@ -5543,7 +5539,7 @@ g_apm_set_cfg_oob(uint32_t src_port, const char *what)
 			    g_map_pa + (uint64_t)oob_off;
 
 			if (f == 1 && g_map_pa == 0) {
-				printf("SWEET MARK: oobcfg v6 try %u no region base, abs form skipped\n",
+				printf("SWEET MARK: oobcfg v7 try %u no region base, abs form skipped\n",
 				    t * SWEET_OOB_FORMS + f);
 				continue;
 			}
@@ -5557,7 +5553,7 @@ g_apm_set_cfg_oob(uint32_t src_port, const char *what)
 			g_put32(pkt + 24 + 4, (uint32_t)(addr >> 32));
 			g_put32(pkt + 24 + 8, g_shm_handle);
 			g_put32(pkt + 24 + 12, off);
-			printf("SWEET MARK: oobcfg v6 try %u form=%s off=%#x addr=%#llx len=%u recs=%u handle=%#x\n",
+			printf("SWEET MARK: oobcfg v7 try %u form=%s off=%#x addr=%#llx len=%u recs=%u handle=%#x\n",
 			    t * SWEET_OOB_FORMS + f, f == 0 ? "bare" : "abs",
 			    oob_off, addr, off, SWEET_OOB_RECS, g_shm_handle);
 			sweet_log_sync();
@@ -5587,7 +5583,7 @@ g_apm_set_cfg_oob(uint32_t src_port, const char *what)
