@@ -5389,6 +5687,8 @@
 
 	/* Independent of the audio stack; gated by sweetgpu=1. */
 	g_gpu_probe();
+	/* Kernel-side GMU bring-up; gated by sweetgmuboot=1. */
+	g_gmu_boot();
 	/* Independent too: gated by sweetsmp=1. */
 	sweet_smp_start();
 
