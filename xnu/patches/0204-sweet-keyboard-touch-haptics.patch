 /*
+ * Short input-path pulse used when UIKit does not deliver a haptics event.
+ * The caller gates this to the lower screen area; sweetkeyboardhap=0 disables
+ * it without affecting physical-key feedback.
+ */
+void
+sweet_haptics_tap(void)
+{
+	int on = 1;
+
+	if (!g_hap_ready) {
+		return;
+	}
+	(void)PE_parse_boot_argn("sweetkeyboardhap", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	g_hap_tap_pending = 1;
+	thread_wakeup((event_t)&g_hap_chan);
+}
