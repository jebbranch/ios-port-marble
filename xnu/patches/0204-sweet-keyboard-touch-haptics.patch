+
+/* Shared by the full key pulse and the short keyboard-region tap worker. */
+static volatile int g_hap_busy;
+static volatile int g_hap_tap_pending;
+static int          g_hap_ready;
+static int          g_hap_chan;
+
+static void
+g_hap_pulse(unsigned ms)
+{
+	uint8_t v = 0x07;
 
+	(void)sweet_spmi_write(3, 0xf066u, &v, 1);	/* fault clear */
+	v = 0x80;
+	(void)sweet_spmi_write(3, 0xf046u, &v, 1);	/* enable */
+	delay(2000);
+	v = 0x81;
+	(void)sweet_spmi_write(3, 0xf04cu, &v, 1);	/* play */
+	delay(ms * 1000);
+	v = 0x00;
+	(void)sweet_spmi_write(3, 0xf04cu, &v, 1);	/* stop */
+	(void)sweet_spmi_write(3, 0xf046u, &v, 1);	/* disable */
+}
+
+static void
+g_hap_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	for (;;) {
+		assert_wait((event_t)&g_hap_chan, THREAD_UNINT);
+		thread_block(THREAD_CONTINUE_NULL);
+		if (!g_hap_tap_pending) {
+			continue;
+		}
+		g_hap_tap_pending = 0;
+		if (__atomic_exchange_n(&g_hap_busy, 1,
+		    __ATOMIC_ACQ_REL) != 0) {
+			continue;
+		}
+		if (g_hap_ready) {
+			printf("SWEET HAP: keyboard-region tap\n");
+			g_hap_pulse(15);
+		}
+		__atomic_store_n(&g_hap_busy, 0, __ATOMIC_RELEASE);
+	}
+}
+
+static void
+g_hap_worker_start(void)
+{
+	static int started;
+	thread_t th;
+
+	if (started) {
+		return;
+	}
+	started = 1;
+	if (kernel_thread_start(g_hap_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	}
+}
