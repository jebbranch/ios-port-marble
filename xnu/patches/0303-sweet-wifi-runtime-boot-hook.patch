+#if SWEET_WIFI_EMBEDDED
+static bool
+sw_wifi_isolated(void)
+{
+	static const char *const off[] = {
+		"sweettouch", "marble_touch", "sweetadsp", "sweetglink", "sweetgpu"
+	};
+	for (unsigned i = 0; i < sizeof(off) / sizeof(off[0]); ++i) {
+		int value = -1;
+		if (!PE_parse_boot_argn(off[i], &value, sizeof(value)) || value != 0)
+			return false;
+	}
+	int gmu = 0;
+	(void)PE_parse_boot_argn("sweetgmuboot", &gmu, sizeof(gmu));
+	return gmu == 0;
+}
+
+static void
+sw_wifi_runtime_thread(void *arg, wait_result_t wr)
+{
+	(void)arg;
+	(void)wr;
+	int error = sw_wifi_phase2(3);
+	printf("SWEET WIFI: runtime exit errno=%d milestone=%u\n",
+	    error, sw_wifi_milestone);
+	sweet_log_sync();
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+#endif
