--- a/bsd/dev/sweet_i2c.c
+++ b/bsd/dev/sweet_i2c.c
@@ -764,7 +764,36 @@
 	printf("SWEET I2C: geni amp %#x profile %u/%u\n", addr, n - bad, n);
 	return bad ? -1 : 0;
 }
+
+/*
+ * Read-back over the same GENI transfer path that already produces
+ * "geni amp %#x r=0 id=%#x".  The register list is taken from the vendor ACF
+ * table itself (0x00 device id / soft-reset, 0x03 and 0x04 SYSCTRL - 0x04 is
+ * written as 0xb440 by aw882xx_music_a, 0x05 next to it), so nothing here is
+ * a guessed datasheet offset.  This exists to turn the "44/44" line into
+ * something stronger than a transmit count, and to give the amplifier side a
+ * witness that does not run through GLINK.
+ */
+void sweet_i2c_amp_readback(const char *tag);
 
+void
+sweet_i2c_amp_readback(const char *tag)
+{
+	static const uint8_t addrs[2] = { 0x34, 0x35 };
+	static const uint8_t regs[4] = { 0x00, 0x03, 0x04, 0x05 };
+
+	for (int i = 0; i < 2; i++) {
+		for (int r = 0; r < 4; r++) {
+			uint16_t v = 0xffff;
+			int rc = se15_aw_read(addrs[i], regs[r], &v);
+
+			printf("SWEET MARK: ampread %s addr=%#x reg=%#x "
+			    "r=%d val=%#x\n", tag, addrs[i], regs[r], rc, v);
+		}
+	}
+	sweet_log_sync();
+}
+
 void sweet_i2c_probe_amps(void);
 
