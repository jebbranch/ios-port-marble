+/*
+ * H round: the content bundle is the variable, so the records are the most common
+ * (iid, param_id, param_size) triple that the vendor's own ACDB actually carries -
+ * measured by walking the props TLV chains of all six on-device files: iid=1
+ * (= APM itself, which is also where a multi-record list is routed),
+ * param 0x08001004, size 52, 1,099 occurrences - and the 52-byte payloads below are
+ * four distinct ones copied verbatim out of CDP_ukee_acdb_cal.acdb.
+ * Four records x 72 = 288 keeps the total payload length, the in-band decision
+ * (>256), the address, the form, the destination and the handle exactly as G
+ * measured them, so a change of answer points at the content and nothing else.
+ * What G sent instead (param 0x08001017, size 12, nine records) appears in zero
+ * ACDB records, which is the suspicion this round tests.
+ */
+static const uint32_t g_oob_miids[SWEET_OOB_RECS] = { 1u, 1u, 1u, 1u };
+
+static const uint32_t g_h_payload[SWEET_OOB_RECS][13] = {
+	/* CDP_ukee_acdb_cal.acdb @0x239e6 */
+	{0x00000003u, 0x00004147u, 0x00000001u, 0x00004167u, 0x00000002u, 0x000043afu, 0x00000001u, 0x00004147u, 0x00000002u, 0x00004167u, 0x0000000bu, 0x00004021u, 0x00000002u},
