 OSDefineMetaClassAndStructors(SweetPlatformExpert, IODTPlatformExpert);
 
+extern "C" int sweet_pon_power_off(void);
+extern "C" void sweet_log_sync(void);
+
+/*
+ * Userland "slide to power off" / "restart" end up in PEHaltRestart ->
+ * gIOPlatform->haltRestart().  Power-off is not a PSCI SYSTEM_OFF on this
+ * firmware: the vendor kernel programs the PMIC PON for SHUTDOWN and then
+ * deasserts PS_HOLD.  The deassert is an SCM call (SVC_PWR 0x09,
+ * DEASSERT_PS_HOLD 0x02, SIP owner, fast call) with the PON configured
+ * first by sweet_pon_power_off().  Reset still uses PSCI SYSTEM_RESET,
+ * which already works (sweetreboot=1 uses it).
+ */
+static uint64_t
+sweet_scm_deassert_ps_hold(void)
+{
+	register uint64_t x0 __asm("x0") = 0xC2090902ull;
+	register uint64_t x1 __asm("x1") = 1;	/* one value argument */
+	register uint64_t x2 __asm("x2") = 0;
+	register uint64_t x3 __asm("x3") = 0;
+	register uint64_t x4 __asm("x4") = 0;
+	register uint64_t x5 __asm("x5") = 0;
+	register uint64_t x6 __asm("x6") = 0;
+	register uint64_t x7 __asm("x7") = 0;
+
+	__asm__ volatile("dsb sy" ::: "memory");
+	__asm__ volatile("smc #0"
+	    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5),
+	      "+r"(x6), "+r"(x7)
+	    :
+	    : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15",
+	      "x16", "x17", "memory");
+	IOLog("SWEET: deassert_ps_hold scm -> %#llx\n",
+	    (unsigned long long)x0);
+	return x0;
+}
+
+static void
+sweet_psci_call(uint64_t fn)
+{
+	register uint64_t x0 __asm("x0") = fn;
+
+	__asm__ volatile("dsb sy" ::: "memory");
+	__asm__ volatile("smc #0" : "+r"(x0) ::
+	    "x1", "x2", "x3", "memory");
+}
+
+/*
+ * The SPMI PON sequence can wedge (the PMIC PON peripheral does not answer
+ * every observer read on this firmware), and the halt thread would then sit
+ * there until the 30 s watchdog panics.  Run a one-shot fallback on its own
+ * thread: after 5 s deassert PS_HOLD directly and fall back to PSCI, so the
+ * device always leaves the halt state.
+ */
+static int g_halt_chan;
+
+static void
+sweet_halt_fallback(void *arg, wait_result_t wr)
+{
+	uint64_t deadline;
+
+	(void)arg;
+	(void)wr;
+	uint64_t r;
+
+	clock_interval_to_deadline(3000, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&g_halt_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+	IOLog("SWEET: halt fallback 3 s -> SCM deassert only\n");
+	sweet_log_sync();
+	r = sweet_scm_deassert_ps_hold();
+	printf("SWEET: halt fallback SCM returned %#llx\n",
+	    (unsigned long long)r);
+	sweet_log_sync();
+	/* Give the PMIC time to cut power; if it did not, restart rather
+	 * than sit until the 30 s watchdog panics. */
+	clock_interval_to_deadline(2000, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&g_halt_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+	IOLog("SWEET: halt fallback still up; PSCI SYSTEM_RESET\n");
+	sweet_log_sync();
+	sweet_psci_call(0x84000009ull);	/* SYSTEM_RESET */
+	for (;;) {
+		__asm__ volatile("wfi");
+	}
+}
+
+static int
+sweet_platform_halt_restart(unsigned int type)
+{
+	switch (type) {
+	case kPEHaltCPU:
+	case kPEUPSDelayHaltCPU:
+		IOLog("SWEET: PON shutdown + PS_HOLD deassert\n");
+		sweet_log_sync();
+		{
+			thread_t th;
+
+			if (kernel_thread_start(sweet_halt_fallback, NULL,
+			    &th) == KERN_SUCCESS) {
+				thread_deallocate(th);
+			} else {
+				IOLog("SWEET: halt fallback thread failed\n");
+			}
+		}
+		(void)sweet_pon_power_off();
+		IOLog("SWEET: PON returned; deassert PS_HOLD\n");
+		sweet_log_sync();
+		(void)sweet_scm_deassert_ps_hold();
+		IOLog("SWEET: PS_HOLD SCM returned; PSCI SYSTEM_OFF\n");
+		sweet_log_sync();
+		sweet_psci_call(0x84000008ull);	/* fallback */
+		break;
+	case kPERestartCPU:
+		IOLog("SWEET: PSCI SYSTEM_RESET\n");
+		sweet_psci_call(0x84000009ull);	/* SYSTEM_RESET */
+		break;
+	case kPEPanicSync:
+		return 0;
+	default:
+		/* Leave panic restarts alone: the panic screen stays up. */
+		return -1;
+	}
+	for (;;) {
+		__asm__ volatile("wfi");
+	}
+}
