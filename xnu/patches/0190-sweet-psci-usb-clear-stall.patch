--- a/iokit/Kernel/arm/SweetPlatformExpert.cpp
+++ b/iokit/Kernel/arm/SweetPlatformExpert.cpp
@@ -22,6 +22,46 @@
 
 OSDefineMetaClassAndStructors(SweetPlatformExpert, IODTPlatformExpert);
 
+/*
+ * PSCI SYSTEM_OFF / SYSTEM_RESET.  The shim already resets the SoC with
+ * the same SMC for sweetreboot=1; userland's "slide to power off" and
+ * "restart" end up in PEHaltRestart -> gIOPlatform->haltRestart(), and
+ * without this hook they return -1 and the machine just stays there.
+ */
+static void
+sweet_psci_call(uint64_t fn)
+{
+	register uint64_t x0 __asm("x0") = fn;
+
+	__asm__ volatile("dsb sy" ::: "memory");
+	__asm__ volatile("smc #0" : "+r"(x0) ::
+	    "x1", "x2", "x3", "memory");
+}
+
+static int
+sweet_platform_halt_restart(unsigned int type)
+{
+	switch (type) {
+	case kPEHaltCPU:
+	case kPEUPSDelayHaltCPU:
+		IOLog("SWEET: PSCI SYSTEM_OFF\n");
+		sweet_psci_call(0x84000008ull);	/* SYSTEM_OFF */
+		break;
+	case kPERestartCPU:
+		IOLog("SWEET: PSCI SYSTEM_RESET\n");
+		sweet_psci_call(0x84000009ull);	/* SYSTEM_RESET */
+		break;
+	case kPEPanicSync:
+		return 0;
+	default:
+		/* Leave panic restarts alone: the panic screen stays up. */
+		return -1;
+	}
+	for (;;) {
+		__asm__ volatile("wfi");
+	}
+}
+
 bool
 SweetPlatformExpert::start(IOService *provider)
 {
@@ -29,6 +69,7 @@
 	if (!IODTPlatformExpert::start(provider)) {
 		return false;
 	}
+	PE_halt_restart = sweet_platform_halt_restart;
 	registerService();
 	IOLog("SWEET: platform expert registered\n");
 	return true;
