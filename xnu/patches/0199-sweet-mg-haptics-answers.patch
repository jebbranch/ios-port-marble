+
+/*
+ * MobileGestalt persists the answers it computed in a plist.  A "false" for
+ * the haptics keys from an earlier boot would survive the getter patches
+ * above, because MG consults the cache before recomputing.  Remove the
+ * caches before launchd starts; MG recreates them on demand from the
+ * (patched) getters and the device tree.
+ *
+ * sweetmgcache=0 keeps the caches (for a boot where the old values are
+ * wanted).  Missing files are normal and logged as "absent".
+ */
+static const char * const sweet_mg_cache_paths[] = {
+	"/private/var/containers/Shared/SystemGroup/"
+	"systemgroup.com.apple.mobilegestaltcache/Library/Caches/"
+	"com.apple.MobileGestalt.plist",
+	"/var/mobile/Library/Caches/com.apple.MobileGestalt.plist",
+};
+
+static int
+sweet_unlink_file(const char *path, vfs_context_t ctx)
+{
+	struct nameidata nd;
+	vnode_t dvp;
+	vnode_t vp = NULLVP;
+	int error;
+
+	NDINIT(&nd, DELETE, OP_UNLINK, LOCKPARENT, UIO_SYSSPACE,
+	    CAST_USER_ADDR_T(path), ctx);
+	error = namei(&nd);
+	if (error) {
+		return error;
+	}
+	dvp = nd.ni_dvp;
+	error = vn_remove(dvp, &nd.ni_vp, &nd.ni_cnd, 0, NULL, ctx);
+	vp = nd.ni_vp;
+	nameidone(&nd);
+	vnode_put(dvp);
+	if (vp != NULLVP) {
+		vnode_put(vp);
+	}
+	return error;
+}
+
+void
+sweet_reset_mg_cache(void)
+{
+	uint32_t mode = 1;
+	vfs_context_t ctx;
+
+	(void)PE_parse_boot_argn("sweetmgcache", &mode, sizeof(mode));
+	if (mode == 0) {
+		return;
+	}
+	ctx = vfs_context_create(NULL);
+	if (ctx == NULL) {
+		printf("SWEET MG: no vfs context\n");
+		return;
+	}
+	for (size_t i = 0; i < sizeof(sweet_mg_cache_paths) /
+	    sizeof(sweet_mg_cache_paths[0]); i++) {
+		int error = sweet_unlink_file(sweet_mg_cache_paths[i], ctx);
+
+		if (error == 0) {
+			printf("SWEET MG: cache removed\n");
+		} else if (error == ENOENT) {
+			printf("SWEET MG: cache absent\n");
+		} else {
+			printf("SWEET MG: unlink failed %d\n", error);
+		}
+	}
+	vfs_context_rele(ctx);
+}
