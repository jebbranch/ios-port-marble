+/*
+ * ToneLibrary, UIKit and CoreHaptics also ask MobileGestalt for those keys
+ * directly instead of going through the CoreHaptics wrappers above.  The MG
+ * key table maps
+ *
+ *   "cBy4BcYs5YWtFHbBpt4C6A" (haptics)      -> getter 0x19c576454
+ *   "gqDnklGQnpv5ilgh5uHckw" (closed loop)  -> getter 0x19c564a9c
+ *
+ * and both getters read the IORegistry device tree (/product and
+ * /product/haptics).  iOS 16.7 expects obfuscated property names that the
+ * D22AP device tree does not carry, so both answer false on marble.  Their
+ * return value is a bool, so replace the entry with "mov w0,#1; ret; nop".
+ * (The vibrator key ORs the haptics key, so it follows automatically.)
+ *
+ * Both live in libMobileGestalt, which is in the same .09 subcache as the
+ * prewarm patch (__TEXT base 0x19b758000).
+ */
+#define SWEET_CACHE_MG_HAPTIC_OFF	0xe1e454ULL
+#define SWEET_CACHE_MG_CLOSEDLOOP_OFF	0xe0ca9cULL
+
+static const uint8_t sweet_mg_haptic_orig[12] = {
+	0xc0, 0x01, 0x00, 0xb0,		/* adrp x0, ... */
+	0x00, 0xd4, 0x26, 0x91,		/* add  x0, x0, ... */
+	0x21, 0x6f, 0x1d, 0xf0,		/* adrp x1, ... */
+};
+static const uint8_t sweet_mg_closedloop_orig[12] = {
+	0x80, 0x02, 0x00, 0xb0,
+	0x00, 0x84, 0x38, 0x91,
+	0xa1, 0x6f, 0x1d, 0x90,
+};
+
