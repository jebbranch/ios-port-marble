 	{ SWEET_CACHE_HAPTICS, "haptics capability (closed loop)",
 	  SWEET_CACHE_CLOSEDLOOP_OFF, 12, sweet_hap_orig3, sweet_hap_true },
+	{ SWEET_CACHE_PREWARM, "MG haptics key",
+	  SWEET_CACHE_MG_HAPTIC_OFF, 12, sweet_mg_haptic_orig,
+	  sweet_hap_true },
