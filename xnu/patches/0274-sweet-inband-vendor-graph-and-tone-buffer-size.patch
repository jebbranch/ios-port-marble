+/*
+ * 0275: the per-buffer payload size, so "make it longer" is a boot argument and
+ * not a build.  G_PCM_BYTES stays the shipped default and sweetdbb only ever
+ * moves UP from it (validated in g_pcm_bytes_init).  The fill window moves with
+ * it on purpose: g_fill_tone writes exactly this many bytes per offset, so a
+ * bigger send over an un-filled window would stream whatever the shim left
+ * past our tone and a later "silent at the end" would be read as a statement
+ * about the DSP when it is a statement about our own buffer.  1152 B is 6 ms at
+ * 48 kHz/16-bit/stereo; the vendor-scale 4096 B is ~21 ms per buffer, so a
+ * 120-buffer tone becomes ~2.5 s of audio instead of ~0.7 s.
+ */
+static uint32_t g_pcm_bytes = G_PCM_BYTES;
+
+static void
+g_pcm_bytes_init(void)
+{
+	static int done = 0;
+	uint32_t bb = 0;
+
+	if (done) {
+		return;
+	}
+	done = 1;
+	(void)PE_parse_boot_argn("sweetdbb", &bb, sizeof(bb));
+	if (bb >= G_PCM_BYTES && bb <= 0x4000u && (bb % 64u) == 0 &&
+	    bb > g_pcm_bytes) {
+		g_pcm_bytes = bb;
+	}
+	printf("SWEET MARK: dbb v1 bytes=%u ms=%u\n", g_pcm_bytes,
+	    (unsigned)(g_pcm_bytes / 192u));
+	sweet_log_sync();
+}
