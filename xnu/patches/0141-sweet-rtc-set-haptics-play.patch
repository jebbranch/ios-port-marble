+/*
+ * One byte read through the "chnls" window at a candidate stride.  Used only
+ * to prove that a RW slot maps to the APID we think it does.
+ */
+static bool
+sp_chnl_read(uint16_t apid, unsigned addr, unsigned shift, uint8_t *out)
+{
+	unsigned off = apid << shift;
+	uint32_t cmd = (1u << 27) | ((addr & 0xffu) << 4);
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(sp_chnl + off) = cmd;
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = sp_rd(sp_chnl, off + 0x08u);
+		if (status & 1u) {
+			if (status & 0x0eu) {
+				return false;
+			}
+			*out = (uint8_t)sp_rd(sp_chnl, off + 0x18u);
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+int
+sweet_spmi_write(unsigned sid, unsigned addr, const uint8_t *buf,
+    unsigned len)
+{
+	unsigned peripheral = addr >> 8;
+	if (!sp_ready || !buf || len < 1 || len > 4 || sid > 15 ||
+	    addr > 0xffffu ||
+	    !((sid == 3 && (peripheral == 0xf0 || peripheral == 0xf2)) ||
+	    (sid == 0 && peripheral == 0x61))) {
+		return -1;
+	}
+	IOLockLock(sp_lock);
+	uint16_t apid = sp_find_apid((sid << 8) | peripheral);
+	if (apid == SP_NO_APID || sp_poisoned[apid]) {
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+
+	/* Prove the RW slot: read the target register back through chnls. */
+	unsigned shift = sp_rw_shift;
+	if (!shift) {
+		uint8_t want = 0, got = 0;
+		IOLockUnlock(sp_lock);
+		if (sweet_spmi_read(sid, addr, &want) != 0) {
+			return -1;
+		}
+		IOLockLock(sp_lock);
+		apid = sp_find_apid((sid << 8) | peripheral);
+		if (apid == SP_NO_APID || sp_poisoned[apid]) {
+			IOLockUnlock(sp_lock);
+			return -1;
+		}
+		if (sp_chnl_read(apid, addr, 12, &got) && got == want) {
+			shift = 12;
+		} else if (sp_chnl_read(apid, addr, 16, &got) && got == want) {
+			shift = 16;
+		} else {
+			printf("SWEET BATTERY: RW slot for sid=%u per=%#x "
+			    "not verified (want=%02x got=%02x)\n",
+			    sid, peripheral, want, got);
+			IOLockUnlock(sp_lock);
+			return -1;
+		}
+		sp_rw_shift = shift;
+		printf("SWEET BATTERY: RW slot verified at stride %#x\n",
+		    1u << shift);
+	}
+
+	unsigned off = apid << shift;
+	uint32_t word = 0;
+	for (unsigned i = 0; i < len; ++i) {
+		word |= (uint32_t)buf[i] << (8 * i);
+	}
+	uint32_t cmd = ((addr & 0xffu) << 4) | (len - 1u); /* EXT_WRITEL */
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(sp_chnl + off + 0x10u) = word;
+	*(volatile uint32_t *)(sp_chnl + off) = cmd;
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = sp_rd(sp_chnl, off + 0x08u);
+		if (status & 1u) {
+			if (status & 0x0eu) {
+				printf("SWEET BATTERY: SPMI write denied sid=%u "
+				    "addr=%#x status=%#x\n", sid, addr, status);
+				IOLockUnlock(sp_lock);
+				return -1;
+			}
+			IOLockUnlock(sp_lock);
+			return 0;
+		}
+		delay(1);
+	}
+	sp_poisoned[apid] = true;
+	printf("SWEET BATTERY: SPMI write timeout sid=%u addr=%#x APID=%u\n",
+	    sid, addr, apid);
+	IOLockUnlock(sp_lock);
+	return -1;
+}
