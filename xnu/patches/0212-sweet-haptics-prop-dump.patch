+/* Dump a property value (numbers/strings/data/bool, one or two dict levels). */
+static void
+sweet_hap_log_value(const char *key, OSObject *val, int depth)
+{
+	if (val == NULL) {
+		SWEET_HAP_LOG("SWEET HAPTICS:   %s = <null>\n", key);
+		return;
+	}
+	OSNumber *num = OSDynamicCast(OSNumber, val);
+	if (num != NULL) {
+		SWEET_HAP_LOG("SWEET HAPTICS:   %s = %llu (%#llx)\n", key,
+		    (unsigned long long)num->unsigned64BitValue(),
+		    (unsigned long long)num->unsigned64BitValue());
+		return;
+	}
+	OSBoolean *b = OSDynamicCast(OSBoolean, val);
+	if (b != NULL) {
+		SWEET_HAP_LOG("SWEET HAPTICS:   %s = %s\n", key,
+		    b->getValue() ? "true" : "false");
+		return;
+	}
+	OSString *str = OSDynamicCast(OSString, val);
+	if (str != NULL) {
+		SWEET_HAP_LOG("SWEET HAPTICS:   %s = \"%s\"\n", key,
+		    str->getCStringNoCopy());
+		return;
+	}
+	OSData *data = OSDynamicCast(OSData, val);
+	if (data != NULL) {
+		const uint8_t *p = (const uint8_t *)data->getBytesNoCopy();
+		uint32_t n = data->getLength();
+		uint32_t m = n > 24 ? 24 : n;
+		char hex[3 * 24 + 1];
+
+		for (uint32_t i = 0; i < m; i++) {
+			static const char digits[] = "0123456789abcdef";
+
+			hex[3 * i] = digits[p[i] >> 4];
+			hex[3 * i + 1] = digits[p[i] & 15];
+			hex[3 * i + 2] = (i + 1 == m) ? '\0' : ' ';
+		}
+		hex[3 * m] = '\0';
+		SWEET_HAP_LOG("SWEET HAPTICS:   %s = data %u: %s%s\n", key, n, hex,
+		    n > m ? " ..." : "");
+		return;
+	}
+	OSDictionary *sub = OSDynamicCast(OSDictionary, val);
+	if (sub != NULL) {
+		SWEET_HAP_LOG("SWEET HAPTICS:   %s = dict(%u)\n", key,
+		    (unsigned)sub->getCount());
+		if (depth < 2) {
+			OSCollectionIterator *it =
+			    OSCollectionIterator::withCollection(sub);
+			OSObject *k;
+
+			while (it != NULL && (k = it->getNextObject()) != NULL) {
+				const OSSymbol *ks = OSDynamicCast(OSSymbol, k);
+
+				if (ks == NULL) {
+					continue;
+				}
+				sweet_hap_log_value(ks->getCStringNoCopy(),
+				    sub->getObject(ks), depth + 1);
+			}
+			if (it != NULL) {
+				it->release();
+			}
+		}
+		return;
+	}
+	OSArray *arr = OSDynamicCast(OSArray, val);
+	if (arr != NULL) {
+		SWEET_HAP_LOG("SWEET HAPTICS:   %s = array(%u)\n", key,
+		    (unsigned)arr->getCount());
+		if (depth < 2) {
+			unsigned count = arr->getCount();
+			char name[64];
+
+			for (unsigned i = 0; i < count && i < 16; i++) {
+				snprintf(name, sizeof(name), "%s[%u]", key, i);
+				sweet_hap_log_value(name, arr->getObject(i),
+				    depth + 1);
+			}
+		}
+		return;
+	}
+	SWEET_HAP_LOG("SWEET HAPTICS:   %s = <%s>\n", key,
+	    val->getMetaClass()->getClassName());
 }
 
