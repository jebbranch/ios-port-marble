 static IOBufferMemoryDescriptor *gSweetHapBuf;
@@ -130,10 +128,16 @@
 	for (uint32_t i = 0; i < arguments->scalarOutputCount && i < 8; i++) {
 		arguments->scalarOutput[i] = 0;
 	}
