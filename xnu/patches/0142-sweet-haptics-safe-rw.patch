+/* One byte through the observer window at an explicit stride. */
+static bool
+sp_obs_read_stride(uint16_t apid, unsigned addr, unsigned stride,
+    uint8_t *out)
+{
+	unsigned off = stride * apid;
+	uint32_t cmd = (1u << 27) | ((addr & 0xffu) << 4);
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(sp_obs + off) = cmd; /* EXT_READL, BC=0 */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = sp_rd(sp_obs, off + 0x08u);
+		if (status & 1u) {
+			if (status & 0x0eu) {
+				return false;
+			}
+			*out = (uint8_t)sp_rd(sp_obs, off + 0x18u);
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static bool
+sp_obs_read(uint16_t apid, unsigned addr, uint8_t *out)
+{
+	return sp_obs_read_stride(apid, addr, sp_obs_stride, out);
+}
+
+/*
+ * One byte read through the "chnls" window at a candidate stride.  Used only
+ * to prove that a RW slot maps to the APID we think it does.
+ */
+static bool
+sp_chnl_read(uint16_t apid, unsigned addr, unsigned shift, uint8_t *out)
+{
+	unsigned off = apid << shift;
+	uint32_t cmd = (1u << 27) | ((addr & 0xffu) << 4);
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(sp_chnl + off) = cmd;
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = sp_rd(sp_chnl, off + 0x08u);
+		if (status & 1u) {
+			if (status & 0x0eu) {
+				return false;
+			}
+			*out = (uint8_t)sp_rd(sp_chnl, off + 0x18u);
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
