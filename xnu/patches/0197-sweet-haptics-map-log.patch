+/* The haptics buffer the client maps.  Retained for the lifetime of the
+ * kernel so the close-time dump cannot touch freed memory. */
+static IOBufferMemoryDescriptor *gSweetHapBuf;
+static uint8_t gSweetHapLast[64];
+static bool gSweetHapHaveLast;
+
 /*
  * Common user client.  Unknown selectors are acknowledged (so the caller
  * keeps going and we see the whole sequence) but nothing is played.
@@ -40,7 +50,12 @@
