 IOReturn
+SweetHapticsUCBase::registerNotificationPort(mach_port_t port, UInt32 type,
+    UInt32 refCon)
+{
+	IOLog("SWEET HAPTICS: %s notify port type=%u ref=%#x\n", getName(),
+	    (unsigned)type, (unsigned)refCon);
+	return kIOReturnSuccess;
+}
+
+void
+SweetHapticsUCBase::dumpBuffer(const char *why)
+{
+	uint8_t now[64];
+	uint32_t n = sizeof(now);
+
+	if (!gSweetHapBuf || gSweetHapBuf->readBytes(0, now, n) != n) {
+		return;
+	}
+	if (gSweetHapHaveLast && memcmp(now, gSweetHapLast, n) == 0) {
+		return;
+	}
+	memcpy(gSweetHapLast, now, n);
+	gSweetHapHaveLast = true;
+	sweet_haptics_dump(why, now, n);
+}
+
+static void
+sweet_haptics_props(IOService *service, OSObject *properties)
+{
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	OSCollectionIterator *it;
+
+	if (dict == NULL) {
+		IOLog("SWEET HAPTICS: %s setProperties (non-dict)\n",
+		    service->getName());
+		return;
+	}
+	it = OSCollectionIterator::withCollection(dict);
+	if (it == NULL) {
+		return;
+	}
+	IOLog("SWEET HAPTICS: %s setProperties count=%u\n",
+	    service->getName(), (unsigned)dict->getCount());
+	OSObject *key;
+	while ((key = it->getNextObject()) != NULL) {
+		const OSSymbol *sym = OSDynamicCast(OSSymbol, key);
+		IOLog("SWEET HAPTICS:   prop %s\n",
+		    sym ? sym->getCStringNoCopy() : "?");
+	}
+	it->release();
+}
+
+IOReturn
+SweetHapticsUCBase::clientMemoryForType(UInt32 type, IOOptionBits *options,
+    IOMemoryDescriptor **memory)
+{
+	IOBufferMemoryDescriptor *buf;
+
+	IOLog("SWEET HAPTICS: %s map type=%u options=%#x\n", getName(),
+	    (unsigned)type, options ? (unsigned)*options : 0);
+	buf = IOBufferMemoryDescriptor::withCapacity(0x10000,
+	    kIODirectionInOut, true);
+	if (buf == NULL) {
+		return kIOReturnNoMemory;
+	}
+	if (gSweetHapBuf == NULL) {
+		buf->retain();          /* our copy; the client owns its map ref */
+		gSweetHapBuf = buf;
+	}
+	*memory = buf;
+	return kIOReturnSuccess;
+}
+
+IOReturn
 SweetHapticsUCBase::clientClose(void)
 {
 	IOLog("SWEET HAPTICS: %s closed (pid %d)\n", getName(), fPid);
+	dumpBuffer("  buffer at close");
 	return IOUserClient::clientClose();
 }
 
