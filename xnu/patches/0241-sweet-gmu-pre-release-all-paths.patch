 			g_hfi_dump(hfi, 60000u);
 			if (kernel_thread_start((thread_continue_t)g_rel_thread,
 			    NULL, &th) == KERN_SUCCESS) {
@@ -3677,6 +3724,8 @@ g_gmu_boot(void)
