+		printf("SWEET GLINK: %s rsp op=%#x status=%#x hop=%#x len=%u\n",
+		    what, op, status, hop, g_rsp_len);
+		sweet_log_sync();
+		return status == 0 ? 0 : -1;
+	}
+	printf("SWEET GLINK: %s rsp %u bytes\n", what, g_rsp_len);
+	return -1;
+}
