+			if (fsr != 0 || far != 0) {
+				printf("SWEET SMMU: %s cb%u FSR=%#x FAR=%#x "
+				    "FSYNR0=%#x farhi=%#x\n", tag, n, fsr, far, fsyn,
+			    *(volatile uint32_t *)(g_cb_win + n * 0x1000u +
+			    0x64u));
+			}
+		}
+	}
+	sweet_log_sync();
