+g_apm_xfer(uint8_t *pkt, uint32_t pkt_size, const char *what)
+{
+	g_rsp_ready = 0;
+	g_rsp_len = 0;
+	g_send_gpr(pkt, pkt_size);
+	for (unsigned i = 0; i < 5000; i += 5) {
+		g_drain(0);
