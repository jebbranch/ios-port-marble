+		}
+		g_wait(5);
+	}
+	if (!g_rsp_ready) {
+		printf("SWEET GLINK: %s: no response\n", what);
+		return -1;
+	}
+	if (g_rsp_len >= 28) {
+		uint32_t hop = g_le32(g_rsp + 20);      /* packet opcode */
+		uint32_t op = g_le32(g_rsp + 24);
+		uint32_t status;
