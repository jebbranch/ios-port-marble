+		 * plus a bare 4-byte mem_map_handle.  It is a success reply,
+		 * not a GPR basic response. */
+		if (g_rsp_len == 28 || hop == 0x02001001u) {
+			op = APM_CMD_SHARED_MEM_MAP_REGIONS;
+			status = 0;
+		} else if (g_rsp_len >= 32) {
