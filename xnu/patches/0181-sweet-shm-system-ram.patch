+	if (g_apm_graph_ctrl_list(src_port, ids, n, APM_CMD_GRAPH_PREPARE,
+	    "graph_prepare") != 0) {
+		return -1;
+	}
+	return g_apm_graph_ctrl_list(src_port, ids, n, APM_CMD_GRAPH_START,
+	    "graph_start");
+}
