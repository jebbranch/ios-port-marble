 };
 OSDefineMetaClassAndStructors(AppleAOPAudioButtonHapticDevice, IOService);
 
@@ -602,9 +615,32 @@ AppleAOPAudioButtonHapticDevice::start(IOService *provider)
 	}
 	registerService();
 	SWEET_HAP_LOG("SWEET HAPTICS: AppleAOPAudioButtonHapticDevice registered\n");
+	SWEET_HAP_LOG("SWEET HAPID: bhap start self=%#llx provider=%#llx pname=%s\n",
