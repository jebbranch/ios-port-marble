 }
 
+/*
+ * Which of the published bhap instances the client attached to.  There are
+ * more "registered" events than opens, so instance identity - not the
+ * registration count - is what has to be read before the duplicates can be
+ * attributed to a cause.
+ */
+bool
+AppleAOPAudioButtonHapticDevice::open(IOService *forClient,
+    IOOptionBits options, void *arg)
+{
+	bool ok = IOService::open(forClient, options, arg);
+
+	SWEET_HAP_LOG("SWEET HAPID: bhap open self=%#llx client=%#llx opts=%#x ok=%d\n",
+	    (unsigned long long)(uintptr_t)this,
+	    (unsigned long long)(uintptr_t)forClient,
+	    (unsigned)options, ok ? 1 : 0);
+	return ok;
+}
