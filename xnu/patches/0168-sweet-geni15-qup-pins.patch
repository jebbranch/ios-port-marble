+/* The bit-bang pass leaves both pads as GPIO outputs; GENI only reaches the
+ * bus once they carry the QUP function (mux 1, as in sweet_touch) and the
+ * DT-requested internal pull-up. */
+static void
+se15_pins(void)
+{
+	static const uint32_t pa[2] = { 0x0f138000u, 0x0f139000u };
+
+	for (int i = 0; i < 2; i++) {
+		vm_offset_t v = ml_io_map(pa[i], 0x1000u);
+		uint32_t cfg;
+
+		if (!v) {
+			printf("SWEET I2C: pin %d map failed\n", 56 + i);
+			continue;
+		}
+		cfg = *(volatile uint32_t *)v;
+		cfg &= ~0x3ffu;
+		cfg |= (1u << 2) | 3u | (2u << 6);
+		*(volatile uint32_t *)v = cfg;
+		__asm__ volatile("dsb osh" ::: "memory");
+		printf("SWEET I2C: pin %d cfg=%#x level=%u\n", 56 + i,
+		    *(volatile uint32_t *)v,
+		    *(volatile uint32_t *)(v + 4) & 1u);
+	}
+	sweet_log_sync();
 }
 
