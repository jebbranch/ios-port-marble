-		(void)sp_obs_read_stride(apid, SP_HAP_REV, sp_obs_stride, &rev);
+		/* REVISION2: 2 = HAP520.  REVISION1 is 0 on this part. */
+		(void)sp_obs_read_stride(apid, SP_HAP_REV + 1u, sp_obs_stride, &rev);
 	}
 	printf("SWEET BATTERY: SPMI arb=%#x APIDs=%u obs-stride=%#x "
