@@ -300,7 +301,7 @@
 	uint8_t want = 0, got = 0;
 
 	if (apid == SP_NO_APID || sp_poisoned[apid] ||
-	    sp_obs_read(apid, SP_HAP_REV, &want) != 0 ||
+	    sp_obs_read(apid, SP_HAP_REV + 1u, &want) != 0 ||
 	    want < 1 || want > 5) {
 		printf("SWEET BATTERY: no haptics ID for RW probe (rev=%#x)\n",
 		    want);
@@ -310,7 +311,7 @@
 	 * chnls is 4 MiB.  768 APIDs at 0x10000 each would need 48 MiB, so the
