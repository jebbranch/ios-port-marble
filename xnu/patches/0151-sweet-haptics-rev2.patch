--- a/bsd/dev/sweet_glink.c
+++ b/bsd/dev/sweet_glink.c
@@ -947,15 +947,21 @@
 static void
 g_haptics_try(void)
 {
-	uint8_t rev = 0, ptn = 0, v = 0;
+	uint8_t rev1 = 0, rev = 0, ptn = 0, v = 0;
 
-	if (sweet_spmi_init() != 0 ||
-	    sweet_spmi_read(3, 0xf000, &rev) != 0 || rev < 1 || rev > 5) {
-		printf("SWEET HAP: no cfg revision (rev=%#x)\n", rev);
+	if (sweet_spmi_init() != 0) {
+		return;
