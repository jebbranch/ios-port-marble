@@ -5819,6 +5915,7 @@ g_audio_tone(uint32_t src_port, uint32_t dst_port)
 		}
 	}
 	printf("SWEET GLINK: pcm tone done (%d buffers)\n", tone_buffers);
+	g_ibat_burst("post");
 }
 
