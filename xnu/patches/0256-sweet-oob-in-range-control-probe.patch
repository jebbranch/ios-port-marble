 			    oob_off, addr, off, SWEET_OOB_RECS, g_shm_handle);
 			sweet_log_sync();
@@ -5573,7 +5579,7 @@ g_apm_set_cfg_oob(uint32_t src_port, const char *what)
 			g_smmu_faults("oobcfg-post");
