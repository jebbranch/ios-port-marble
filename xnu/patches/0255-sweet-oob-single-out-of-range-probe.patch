diff --git a/bsd/dev/sweet_glink.c b/bsd/dev/sweet_glink.c
index f8df75d..60a4fd7 100644
--- a/bsd/dev/sweet_glink.c
+++ b/bsd/dev/sweet_glink.c
@@ -5464,22 +5464,19 @@ g_apm_set_cfg(uint32_t src_port, uint32_t mod_iid, uint32_t pid,
  * instances this graph definitely contains and act as the positive control.
  */
 /*
- * Offsets and address forms to try, in order.  0x1000 is one the vendor
- * actually uses for an out-of-band body and it is free in our region (PCM
- * sits at 0x0 and 0x800, used to 0xc80; the graph payload sits at 0x2000,
- * used to 0x2b90); 0x3000 is the offset boot 17 used and was refused with
- * status 0x1.
+ * F round: exactly one probe, and its advertised payload address is deliberately
+ * outside the region we declared in SHM_MAP (0x5000).  E closed the offset value
+ * and the addressing form (four sends, all status 0x1, hop 0x2001005, i.e. APM
+ * itself answered), and the fault registers turned out to be unreadable, so the
+ * open question is whether APM range-checks the address before it reads the
+ * body.  One refusal per boot: E showed four of them cost us the data plane.
  *
- * The form matters more than the value.  Boot 17's accepted SHM_MAP was
- * "pa=0xa2fe8000 flag=4", i.e. we handed the DSP a region base, and under
- * that handle our DATA_BUFFER commands carry *bare offsets* and work.  The
- * other convention - the one upstream GSL documents - is an absolute address
- * (base + offset).  Boot 17 sampled the bare form once, so neither is
- * exonerated.  Sending the same bytes under both forms in the same boot turns
- * "we are probing at the wrong address" into a measurement instead of a guess.
+ * In-use layout, for the record: PCM at 0x0 and 0x800 (1152 B each, used to
+ * 0xc80), graph payload at 0x2000 (used to 0x2b90), region size 0x5000.  0x6000
+ * is past the end, so the body is never written and never read back here.
  */
-static const uint32_t g_oob_offs[] = { 0x1000u, 0x3000u };
-#define SWEET_OOB_FORMS 2		/* 0 = bare offset, 1 = base + offset */
+static const uint32_t g_oob_offs[] = { 0x6000u };
+#define SWEET_OOB_FORMS 1		/* 0 = bare offset, 1 = base + offset */
 #define SWEET_OOB_RECS  9
 
 static const uint32_t g_oob_miids[SWEET_OOB_RECS] = {
@@ -5498,7 +5495,7 @@ g_apm_set_cfg_oob(uint32_t src_port, const char *what)
 	uint32_t t;
 
 	if (!g_shm_mapped || !g_shm_va) {
-		printf("SWEET MARK: oobcfg v2 no mapping\n");
+		printf("SWEET MARK: oobcfg v3 no mapping\n");
 		return (-1);
 	}
 	memset(body, 0, sizeof(body));
@@ -5516,14 +5513,15 @@ g_apm_set_cfg_oob(uint32_t src_port, const char *what)
 	}
 	for (t = 0; t < sizeof(g_oob_offs) / sizeof(g_oob_offs[0]); t++) {
 		const uint32_t oob_off = g_oob_offs[t];
+		const int in_bounds = (oob_off + off <= g_shm_region_size());
 		uint32_t f;
 
-		if (oob_off + off > g_shm_region_size()) {
-			printf("SWEET MARK: oobcfg v2 off=%#x skipped (region %#x)\n",
+		if (!in_bounds) {
+			printf("SWEET MARK: oobcfg v3 off=%#x is past the declared region %#x, body not written\n",
 			    oob_off, g_shm_region_size());
-			continue;
+		} else {
+			memcpy((void *)(g_shm_va + oob_off), body, off);
 		}
-		memcpy((void *)(g_shm_va + oob_off), body, off);
 		__asm__ volatile("dsb sy" ::: "memory");
 
 		for (f = 0; f < SWEET_OOB_FORMS; f++) {
@@ -5531,7 +5529,7 @@ g_apm_set_cfg_oob(uint32_t src_port, const char *what)
 			    g_map_pa + (uint64_t)oob_off;
 
 			if (f == 1 && g_map_pa == 0) {
-				printf("SWEET MARK: oobcfg v2 try %u no region base, abs form skipped\n",
+				printf("SWEET MARK: oobcfg v3 try %u no region base, abs form skipped\n",
 				    t * SWEET_OOB_FORMS + f);
 				continue;
 			}
@@ -5545,7 +5543,7 @@ g_apm_set_cfg_oob(uint32_t src_port, const char *what)
 			g_put32(pkt + 24 + 4, (uint32_t)(addr >> 32));
 			g_put32(pkt + 24 + 8, g_shm_handle);
 			g_put32(pkt + 24 + 12, off);
-			printf("SWEET MARK: oobcfg v2 try %u form=%s off=%#x addr=%#llx len=%u recs=%u handle=%#x\n",
+			printf("SWEET MARK: oobcfg v3 try %u form=%s off=%#x addr=%#llx len=%u recs=%u handle=%#x\n",
 			    t * SWEET_OOB_FORMS + f, f == 0 ? "bare" : "abs",
 			    oob_off, addr, off, SWEET_OOB_RECS, g_shm_handle);
 			sweet_log_sync();
@@ -5568,20 +5566,22 @@ g_apm_set_cfg_oob(uint32_t src_port, const char *what)
 			printf("SWEET GLINK: %s addr=%#llx rsp op=%#x status=%#x hop=%#x len=%u\n",
 			    what, addr, g_le32(g_rsp + 24), g_le32(g_rsp + 28),
 			    g_le32(g_rsp + 20), g_rsp_len);
-			/* If APM refused because the DSP could not *read* the body, the
-			 * context bank's fault address register is the only thing that
-			 * says which address it actually tried.  The vendor's own packet
-			 * is byte-for-byte our shape (bare offset + handle + size), so
-			 * the packet form is not what differs; this asks the next
-			 * question, namely whether the dereference faulted.  FAR is
-			 * latched, so the pre-snapshot below is the control. */
+			/* Kept because it is one MMIO read pass, but E measured that this
+			 * witness cannot currently speak: all six banks hold FSR=0x400 that
+			 * survives our W1C attempt and the post snapshots were byte-identical
+			 * to pre.  So "no new fault bits" is not evidence of no fault. */
 			g_smmu_faults("oobcfg-post");
 			__asm__ volatile("dsb sy" ::: "memory");
+			if (!in_bounds) {
+				printf("SWEET MARK: oobcfg v3 recs not read back (past the mapping)\n");
+				sweet_log_sync();
+				continue;
+			}
 			for (i = 0; i < SWEET_OOB_RECS; i++) {
 				const uint8_t *rec = (const uint8_t *)g_shm_va +
 				    oob_off + i * 32;
 
-				printf("SWEET MARK: oobcfg v2 rec %u iid=%#x param=%#x size=%u err=%#x\n",
+				printf("SWEET MARK: oobcfg v3 rec %u iid=%#x param=%#x size=%u err=%#x\n",
 				    i, g_le32(rec + 0), g_le32(rec + 4),
 				    g_le32(rec + 8), g_le32(rec + 12));
 			}
