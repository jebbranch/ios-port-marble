+/* ---- Bounded HAL stream adapter: one GLINK owner, no legacy tone/fallback. ---- */
+static uint64_t
+g_hal_now_us(void)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000u;
+}
+
+static void
+g_hal_wait_ms(uint32_t ms)
+{
+	g_wait(ms);
+}
+
+static void
+g_hal_poll(void)
+{
+	(void)g_drain(0);
+	sweet_audio_stream_tick(g_hal_now_us());
+}
+
+static uint32_t
+g_hal_tx_free(void)
+{
+	uint32_t head = g_rd(g_desc_off + 4u);
+	uint32_t tail = g_rd(g_desc_off);
+	uint32_t used = head >= tail ? head - tail : g_tx_len - tail + head;
+
+	return used + 8u < g_tx_len ? g_tx_len - used - 8u : 0u;
+}
+
+static int
+g_hal_send(const uint8_t *packet, uint32_t bytes)
+{
+	struct g_riid *intent;
+	uint32_t span = (bytes + 16u + 7u) & ~7u;
+
+	if (bytes == 0u || bytes > 4096u || span + 8u >= g_tx_len) {
+		return -1;
+	}
+	if (g_gpr_riid(bytes) == NULL) {
+		if (g_hal_tx_free() < 8u) {
+			return -1;
+		}
+		g_send(CMD_RX_INTENT_REQ, (uint16_t)g_lcid, bytes, NULL, 0);
+		if (!g_wait_riid(bytes, 1000u)) {
+			return -1;
+		}
+	}
+	for (uint32_t waited = 0; g_hal_tx_free() < span && waited < 100u; waited += 2u) {
+		g_hal_poll();
+		g_wait(2u);
+	}
+	sweet_audio_stream_tick(g_hal_now_us());
+	intent = g_gpr_riid(bytes);
+	if (intent == NULL || g_hal_tx_free() < span ||
+	    (bytes >= 24u && g_le32(packet + 20) == 0x0400100au &&
+	    sweet_audio_stream_faulted())) {
+		return -1;
+	}
+	intent->in_use = 1;
+	g_send_tx_data(intent->id, packet, bytes);
+	return 0;
+}
+
+static int
+g_hal_store(uint32_t offset, const int16_t *samples, uint32_t bytes)
+{
+	volatile uint32_t *target;
+
+	if (!g_shm_mapped || !g_shm_va || samples == NULL ||
+	    bytes != 4096u || offset >= 0x4000u || (offset & 4095u) != 0u) {
+		return -1;
+	}
+	target = (volatile uint32_t *)(g_shm_va + offset);
+	for (uint32_t frame = 0; frame < 1024u; frame++) {
+		target[frame] = (uint16_t)samples[2u * frame] |
+		    ((uint32_t)(uint16_t)samples[2u * frame + 1u] << 16);
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	return 0;
+}
+
+/* Strict control reply binding; data completions go to the separate owner. */
+static int
+g_hal_xfer(const uint8_t *packet, uint32_t bytes, uint32_t opcode,
+    uint32_t source, uint32_t token, const char *what)
+{
+	g_hal_ctrl_token = token;
+	g_hal_ctrl_source = source;
+	g_hal_ctrl_opcode = opcode;
+	g_hal_ctrl_status = 0xffffffffu;
+	g_hal_ctrl_ready = 0;
+	g_hal_ctrl_pending = 1;
+	if (g_hal_send(packet, bytes) != 0) {
+		g_hal_ctrl_pending = 0;
+		printf("SWEET HALSTREAM: ctrl %s send failed\n", what);
+		return -1;
+	}
+	for (uint32_t waited = 0; waited < 5000u; waited += 5u) {
+		g_hal_poll();
+		if (g_hal_ctrl_ready) {
+			uint32_t status = g_hal_ctrl_status;
+
+			g_hal_ctrl_pending = 0;
+			printf("SWEET MARK: halstream ctrl v1 %s op=%#x status=%#x\n",
+			    what, opcode, status);
+			sweet_log_sync();
+			return status == 0u ? 0 : -1;
+		}
+		g_wait(5u);
+	}
+	g_hal_ctrl_pending = 0;
+	printf("SWEET HALSTREAM: ctrl %s timeout\n", what);
+	sweet_log_sync();
+	return -1;
+}
+
+static int
+g_hal_graph_ctrl(uint32_t source, uint32_t opcode, const char *what)
+{
+	uint8_t packet[64];
+	uint32_t token = 0x4a000000u | (opcode & 65535u);
+
+	memset(packet, 0, sizeof(packet));
+	g_put32(packet, 0x60u | ((uint32_t)sizeof(packet) << 8));
+	g_put32(packet + 4, 0x302u);
+	g_put32(packet + 8, source);
+	g_put32(packet + 12, 1u);
+	g_put32(packet + 16, token);
+	g_put32(packet + 20, opcode);
+	g_put32(packet + 36, 24u);
+	g_put32(packet + 40, 1u);
+	g_put32(packet + 44, APM_PARAM_ID_SUB_GRAPH_LIST);
+	g_put32(packet + 48, 8u);
+	g_put32(packet + 56, 1u);
+	g_put32(packet + 60, 0xb0000002u);
+	return g_hal_xfer(packet, sizeof(packet), opcode, source, token, what);
+}
+
+static int
+g_hal_unmap(void)
+{
+	uint8_t packet[28];
+	uint32_t opcode = 0x0100100du, source = 0x2002u, token = 0x4a00100du;
+
+	memset(packet, 0, sizeof(packet));
+	g_put32(packet, 0x60u | ((uint32_t)sizeof(packet) << 8));
+	g_put32(packet + 4, 0x302u);
+	g_put32(packet + 8, source);
+	g_put32(packet + 12, 1u);
+	g_put32(packet + 16, token);
+	g_put32(packet + 20, opcode);
+	g_put32(packet + 24, g_shm_handle);
+	return g_hal_xfer(packet, sizeof(packet), opcode, source, token, "unmap");
+}
+
+static int
+g_hal_guards(void)
+{
+	static const char *const zero[] = {
+		"sweetbatt", "sweeti2c", "sweetamp", "sweetampfirst",
+		"sweetampverify", "sweetnowait", "sweetdbb", "sweetexp",
+		"sweetgpu", "sweetgmuboot", "sweethap", "sweetsmp", "sweetreboot",
+		"sweetmfc", "sweetmfcget", "sweetvcfg2", "sweetep4308", "sweettdmclk"
+	};
+	static const char *const one[] = {
+		"sweethalbridge", "sweetpcm", "sweetdescsep", "sweets1",
+		"sweets1ap", "sweetiova", "sweetshmhi"
+	};
+	int pass = 1, flag, tdmsup = 0, i2c = 1, amp = 1;
+	int shmflag = 4, region = 0;
+
+	for (uint32_t i = 0; i < sizeof(zero) / sizeof(zero[0]); i++) {
+		flag = 0;
+		(void)PE_parse_boot_argn(zero[i], &flag, sizeof(flag));
+		if (flag != 0) {
+			pass = 0;
+		}
+	}
+	for (uint32_t i = 0; i < sizeof(one) / sizeof(one[0]); i++) {
+		flag = 0;
+		(void)PE_parse_boot_argn(one[i], &flag, sizeof(flag));
+		if (flag != 1) {
+			pass = 0;
+		}
+	}
+	(void)PE_parse_boot_argn("sweettdmvendor", &tdmsup, sizeof(tdmsup));
+	(void)PE_parse_boot_argn("sweeti2c", &i2c, sizeof(i2c));
+	(void)PE_parse_boot_argn("sweetamp", &amp, sizeof(amp));
+	(void)PE_parse_boot_argn("sweetshmflag", &shmflag, sizeof(shmflag));
+	(void)PE_parse_boot_argn("sweetshmsize", &region, sizeof(region));
+	if (tdmsup != 7 || i2c != 0 || amp != 0 || shmflag != 4 ||
+	    (region != 0 && region != 0x5000)) {
+		pass = 0;
+	}
+	printf("SWEET MARK: halstream guard v1 pass=%d\n", pass);
+	sweet_log_sync();
+	return pass;
+}
+
+static void
+g_hal_bringup(void)
+{
+	static const struct sweet_audio_stream_ops ops = {
+		.now_us = g_hal_now_us, .wait_ms = g_hal_wait_ms,
+		.poll = g_hal_poll, .store = g_hal_store, .send = g_hal_send
+	};
+	uint8_t open[40];
+	uint32_t source = 0x2010u, opcode = 0x01001000u, token = 0x4a001000u;
+	int opened = 0, stopped = -1, closed = -1, unmapped = -1;
+
+	if (g_hal_started_once) {
+		printf("SWEET HALSTREAM: graph already attempted; no restart\n");
+		return;
+	}
+	g_hal_started_once = 1;
+	if (g_prm_vote_clock(0x307u, 19200000u, 2u) != 0 ||
+	    g_prm_vote_clock(0x30eu, 22579200u, 5u) != 0 ||
+	    g_apm_shm_map(0x2002u) != 0 ||
+	    g_shm_region_size() != 0x5000u || !g_shm_va ||
+	    !g_shm_mapped || !g_shm_handle) {
+		printf("SWEET HALSTREAM: mapping/clock preflight failed\n");
+		sweet_log_sync();
+		return;
+	}
+	/* Zero the four data pages, then retain the exact accepted descriptor. */
+	printf("SWEET MARK: halstream graph v1 bytes=%u off=%#x\n",
+	    (unsigned)sizeof(g_graph_vp_wr_dec_cnv), 0x4000u);
+	sweet_log_sync();
+	for (uint32_t offset = 0; offset < 0x4000u; offset += 4u) {
+		*(volatile uint32_t *)(g_shm_va + offset) = 0;
+	}
+	for (uint32_t offset = 0; offset < sizeof(g_graph_vp_wr_dec_cnv); offset += 4u) {
+		*(volatile uint32_t *)(g_shm_va + 0x4000u + offset) =
+		    g_le32(g_graph_vp_wr_dec_cnv + offset);
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	memset(open, 0, sizeof(open));
+	g_put32(open, 0x60u | ((uint32_t)sizeof(open) << 8));
+	g_put32(open + 4, 0x302u);
+	g_put32(open + 8, source);
+	g_put32(open + 12, 1u);
+	g_put32(open + 16, token);
+	g_put32(open + 20, opcode);
+	g_put32(open + 24, 0x4000u);
+	g_put32(open + 32, g_shm_handle);
+	g_put32(open + 36, sizeof(g_graph_vp_wr_dec_cnv));
+	if (g_hal_xfer(open, sizeof(open), opcode, source, token, "open") != 0) {
+		printf("SWEET HALSTREAM: open not acknowledged; mapping retained\n");
+		sweet_log_sync();
+		return; /* timeout may mean the DSP opened it; do not unmap */
+	}
+	opened = 1;
+	g_audio_graph_cfg_vp(source); /* AW cal bypassed; no new gain records */
+	if (g_hal_graph_ctrl(source, 0x01001001u, "prepare") != 0 ||
+	    g_hal_graph_ctrl(source, 0x01001002u, "start") != 0) {
+		goto teardown;
+	}
+	(void)sweet_audio_stream_run(g_shm_offset_mode ? 0 : g_shm_pa,
+	    g_shm_region_size(), g_shm_handle, source, G_VP_WR_IID, &ops);
+teardown:
+	if (opened) {
+		stopped = g_hal_graph_ctrl(source, 0x01001003u, "stop");
+		closed = g_hal_graph_ctrl(source, 0x01001004u, "close");
+	}
+	if (stopped == 0 && closed == 0) {
+		unmapped = g_hal_unmap();
+	}
+	printf("SWEET MARK: halstream teardown v1 open=%d stop=%d close=%d unmap=%d\n",
+	    opened, stopped, closed, unmapped);
+	sweet_log_sync();
+	if (unmapped == 0 && stopped == 0 && closed == 0) {
+		g_shm_mapped = 0;
+		sweet_audio_stream_finish();
+	}
+	/* No memory free or forced PAS shutdown if an acknowledgement is absent. */
+}
