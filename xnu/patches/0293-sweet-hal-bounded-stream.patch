@@ -0,0 +1,207 @@
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <libkern/libkern.h>
+#include "sweet_audio_periods.h"
+
+#define MARBLE_PCM_WRITE_V2 0x0400100au
+#define MARBLE_PCM_DONE_V2 0x05001004u
+#define MARBLE_PCM_APPS 3u
+#define MARBLE_PCM_ADSP 2u
+#define MARBLE_PCM_TOKEN 0x80000000u
+#define MARBLE_PCM_TICKET_MAX 0x1fffffffu
+
+static uint32_t
+le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 |
+	       (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static void
+put32(uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)v;
+	p[1] = (uint8_t)(v >> 8);
+	p[2] = (uint8_t)(v >> 16);
+	p[3] = (uint8_t)(v >> 24);
+}
+
+int
+marble_pcm_init(struct marble_pcm_queue *q, uint64_t base, uint32_t region, uint32_t desc,
+    uint32_t desc_bytes, uint32_t handle, uint32_t src, uint32_t dst,
+    uint32_t ticket)
+{
+	if (q == NULL || !handle || !src || !dst || !ticket ||
+	    ticket > MARBLE_PCM_TICKET_MAX || region < MARBLE_PCM_PERIODS * MARBLE_PCM_BYTES ||
+	    desc < MARBLE_PCM_PERIODS * MARBLE_PCM_BYTES || desc > region ||
+	    desc_bytes > region - desc || base > ((uint64_t)-1) - region) {
+		return MARBLE_PCM_BAD;
+	}
+	memset(q, 0, sizeof(*q));
+	q->wire_base = base;
+	q->handle = handle;
+	q->src_port = src;
+	q->dst_port = dst;
+	q->ticket = ticket;
+	return MARBLE_PCM_OK;
+}
+
+int
+marble_pcm_stage(struct marble_pcm_queue *q, uint32_t p, const int16_t *input,
+    uint32_t frames, int muted)
+{
+	uint32_t peak_in = 0, peak_out = 0;
+	struct marble_pcm_period *period;
+
+	if (q == NULL || p >= MARBLE_PCM_PERIODS || frames > MARBLE_PCM_FRAMES ||
+	    (frames != 0 && input == NULL)) {
+		return MARBLE_PCM_BAD;
+	}
+	if (q->fault) {
+		return MARBLE_PCM_FAULT;
+	}
+	if (q->submissions >= MARBLE_PCM_MAX_SUBMISSIONS) {
+		return MARBLE_PCM_BUDGET;
+	}
+	period = &q->period[p];
+	if (period->owner != MARBLE_PCM_FREE) {
+		return MARBLE_PCM_BUSY;
+	}
+	if (q->ticket > MARBLE_PCM_TICKET_MAX) {
+		q->fault = 1;
+		return MARBLE_PCM_FAULT; /* no token wrap/reuse */
+	}
+	for (uint32_t i = 0; i < frames * 2u; i++) {
+		int32_t value = input[i];
+		uint32_t magnitude = (uint32_t)(value < 0 ? -value : value);
+		int32_t output = muted ? 0 : value / MARBLE_PCM_SAFE_DIVISOR;
+		uint32_t out_magnitude = (uint32_t)(output < 0 ? -output : output);
+
+		if (magnitude > peak_in) {
+			peak_in = magnitude;
+		}
+		if (out_magnitude > peak_out) {
+			peak_out = out_magnitude;
+		}
+		period->samples[i] = (int16_t)output;
+	}
+	memset(period->samples + frames * 2u, 0, (MARBLE_PCM_FRAMES - frames) * 4u);
+	period->token = MARBLE_PCM_TOKEN | (q->ticket++ << 2) | p;
+	period->owner = MARBLE_PCM_STAGED;
+	if (peak_in > q->peak_in) {
+		q->peak_in = peak_in;
+	}
+	if (peak_out > q->peak_out) {
+		q->peak_out = peak_out;
+	}
+	q->source_frames += frames;
+	q->silence_frames += MARBLE_PCM_FRAMES - frames;
+	return MARBLE_PCM_OK;
+}
+
+int
+marble_pcm_packet(struct marble_pcm_queue *q, uint32_t p, uint64_t now,
+    uint64_t timeout, uint8_t out[MARBLE_PCM_PACKET_BYTES])
+{
+	struct marble_pcm_period *period;
+	uint64_t address;
+
+	if (q == NULL || p >= MARBLE_PCM_PERIODS || out == NULL || timeout == 0 ||
+	    now > ((uint64_t)-1) - timeout) {
+		return MARBLE_PCM_BAD;
+	}
+	if (q->fault) {
+		return MARBLE_PCM_FAULT;
+	}
+	if (q->submissions >= MARBLE_PCM_MAX_SUBMISSIONS) {
+		return MARBLE_PCM_BUDGET;
+	}
+	period = &q->period[p];
+	if (period->owner != MARBLE_PCM_STAGED) {
+		return MARBLE_PCM_BUSY;
+	}
+	address = q->wire_base + p * MARBLE_PCM_BYTES;
+	memset(out, 0, MARBLE_PCM_PACKET_BYTES);
+	put32(out, (6u << 4) | (MARBLE_PCM_PACKET_BYTES << 8));
+	put32(out + 4, MARBLE_PCM_ADSP | MARBLE_PCM_APPS << 8);
+	put32(out + 8, q->src_port);
+	put32(out + 12, q->dst_port);
+	put32(out + 16, period->token); /* full token, never old low-16 truncation */
+	put32(out + 20, MARBLE_PCM_WRITE_V2);
+	put32(out + 24, (uint32_t)address);
+	put32(out + 28, (uint32_t)(address >> 32));
+	put32(out + 32, q->handle);
+	put32(out + 36, MARBLE_PCM_BYTES);
+	period->deadline = now + timeout;
+	period->owner = MARBLE_PCM_INFLIGHT; /* BEFORE caller hands packet to transport */
+	q->submissions++;
+	return MARBLE_PCM_OK;
+}
+
+int
+marble_pcm_done(struct marble_pcm_queue *q, const uint8_t *packet, uint32_t bytes)
+{
+	uint32_t token, p;
+	struct marble_pcm_period *period;
+	uint64_t address, expected;
+
+	if (q == NULL || packet == NULL || bytes < 40 ||
+	    (le32(packet) & 0xffu) != 0x60u || (le32(packet) >> 8) != bytes) {
+		return MARBLE_PCM_BAD;
+	}
+	if (q->fault) {
+		return MARBLE_PCM_FAULT;
+	}
+	if (le32(packet + 4) != (MARBLE_PCM_APPS | MARBLE_PCM_ADSP << 8) ||
+	    le32(packet + 8) != q->dst_port ||
+	    le32(packet + 12) != q->src_port ||
+	    le32(packet + 20) != MARBLE_PCM_DONE_V2) {
+		q->rejected++;
+		return MARBLE_PCM_STALE;
+	}
+	token = le32(packet + 16);
+	p = token & 3u;
+	period = &q->period[p];
+	address = le32(packet + 24) | (uint64_t)le32(packet + 28) << 32;
+	expected = q->wire_base + p * MARBLE_PCM_BYTES;
+	if (period->owner != MARBLE_PCM_INFLIGHT || token != period->token ||
+	    address != expected || le32(packet + 32) != q->handle) {
+		q->rejected++;
+		return MARBLE_PCM_STALE;
+	}
+	if (le32(packet + 36) != 0) {
+		q->fault = 1;
+		return MARBLE_PCM_FAULT; /* keep DMA-owned memory pinned on error */
+	}
+	period->owner = MARBLE_PCM_FREE;
+	q->completions++;
+	return MARBLE_PCM_OK;
+}
+
+int
+marble_pcm_expire(struct marble_pcm_queue *q, uint64_t now)
+{
+	if (q == NULL) {
+		return MARBLE_PCM_BAD;
+	}
+	if (q->fault) {
+		return MARBLE_PCM_FAULT;
+	}
+	for (uint32_t p = 0; p < MARBLE_PCM_PERIODS; p++) {
+		if (q->period[p].owner == MARBLE_PCM_INFLIGHT && now >= q->period[p].deadline) {
+			q->fault = 1;
+			return MARBLE_PCM_FAULT;
+		}
+	}
+	return MARBLE_PCM_OK;
+}
+
+void
+marble_pcm_abort(struct marble_pcm_queue *q)
+{
+	if (q != NULL) {
+		q->fault = 1;
+	}
+	/* Never free/rewrite outstanding DMA. Owner must STOP/unmap first. */
+}
+#endif
diff --git a/bsd/dev/sweet_audio_periods.h b/bsd/dev/sweet_audio_periods.h
new file mode 100644
index 0000000..95fb9f3
--- /dev/null
+++ b/bsd/dev/sweet_audio_periods.h
@@ -0,0 +1,47 @@
+/*
+ * Portable, offline-verified candidate for the marble PCM feeder.
+ * Caller serializes access; no transport/hardware calls inside this core.
+ */
+#ifndef SWEET_AUDIO_PERIODS_H
+#define SWEET_AUDIO_PERIODS_H
+#include <sys/types.h>
+
+#define MARBLE_PCM_PERIODS 4u
+#define MARBLE_PCM_FRAMES 1024u
+#define MARBLE_PCM_BYTES 4096u
+#define MARBLE_PCM_PACKET_BYTES 68u
+#define MARBLE_PCM_MAX_SUBMISSIONS 30u
+#define MARBLE_PCM_SAFE_DIVISOR 32
+#define MARBLE_PCM_SAFE_PEAK 1024u
+
+enum marble_pcm_result {
+	MARBLE_PCM_OK = 0, MARBLE_PCM_BAD = -1, MARBLE_PCM_BUSY = -2, MARBLE_PCM_STALE = -3,
+	MARBLE_PCM_FAULT = -4, MARBLE_PCM_BUDGET = -5
+};
+enum marble_pcm_owner { MARBLE_PCM_FREE, MARBLE_PCM_STAGED, MARBLE_PCM_INFLIGHT };
+
+struct marble_pcm_period {
+	int16_t samples[MARBLE_PCM_FRAMES * 2];
+	uint32_t owner, token;
+	uint64_t deadline;
+};
+struct marble_pcm_queue {
+	struct marble_pcm_period period[MARBLE_PCM_PERIODS];
+	uint64_t wire_base;
+	uint32_t handle, src_port, dst_port, ticket, submissions;
+	uint32_t completions, rejected, fault, peak_in, peak_out;
+	uint64_t source_frames, silence_frames;
+};
+
+int marble_pcm_init(struct marble_pcm_queue *q, uint64_t wire_base, uint32_t region_bytes,
+    uint32_t descriptor_offset, uint32_t descriptor_bytes, uint32_t handle,
+    uint32_t src_port, uint32_t dst_port, uint32_t first_ticket);
+int marble_pcm_stage(struct marble_pcm_queue *q, uint32_t p, const int16_t *samples,
+    uint32_t frames, int muted);
+int marble_pcm_packet(struct marble_pcm_queue *q, uint32_t p, uint64_t now_us,
+    uint64_t timeout_us, uint8_t out[MARBLE_PCM_PACKET_BYTES]);
+int marble_pcm_done(struct marble_pcm_queue *q, const uint8_t *packet, uint32_t bytes);
+int marble_pcm_expire(struct marble_pcm_queue *q, uint64_t now_us);
+void marble_pcm_abort(struct marble_pcm_queue *q);
+
+#endif
diff --git a/bsd/dev/sweet_audio_stream.c b/bsd/dev/sweet_audio_stream.c
new file mode 100644
index 0000000..cceac10
--- /dev/null
+++ b/bsd/dev/sweet_audio_stream.c
@@ -0,0 +1,278 @@
+/*
+ * Bounded HAL -> AudioReach feeder, first hardware-adapter stage.
+ * No amplifier/I2C/gain calls. Constant /32 attenuation and <=30 submissions.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <libkern/libkern.h>
+#include "sweet_audio_stream.h"
+
+extern void sweet_log_append(const char *c, int size);
+extern uint32_t sweet_audio_bridge_consume(int16_t *out, uint32_t count);
+
+static struct marble_pcm_queue stream_queue;
+static int16_t stream_input[MARBLE_PCM_FRAMES * 2u];
+static int stream_active;
+static int stream_once;
+static uint32_t stream_sent;
+static void stream_log(const char *format, ...)
+    __attribute__((format(printf, 1, 2)));
+
+static void
+stream_log(const char *format, ...)
+{
+	char line[220];
+	va_list ap;
+	int length;
+
+	va_start(ap, format);
+	length = vsnprintf(line, sizeof(line), format, ap);
+	va_end(ap);
+	if (length > 0) {
+		if (length >= (int)sizeof(line)) {
+			length = (int)sizeof(line) - 1;
+		}
+		sweet_log_append(line, length);
+	}
+}
+
+static uint32_t
+stream_word(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 |
+	    (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static uint32_t
+stream_peak(const int16_t *samples, uint32_t frames)
+{
+	uint32_t peak = 0;
+
+	for (uint32_t i = 0; i < frames * 2u; i++) {
+		int32_t value = samples[i];
+		uint32_t magnitude = (uint32_t)(value < 0 ? -value : value);
+
+		if (magnitude > peak) {
+			peak = magnitude;
+		}
+	}
+	return peak;
+}
+
+/* Preserve 128 first input frames for offline S16/F32/shape inspection. */
+static void
+stream_raw_witness(uint32_t frames)
+{
+	uint32_t first = 0, start, bytes;
+	const uint8_t *raw;
+	static const char digits[] = "0123456789abcdef";
+	char hex[129];
+
+	while (first < frames &&
+	    stream_peak(stream_input + 2u * first, 1u) < 32u) {
+		first++;
+	}
+	start = first > 8u ? first - 8u : 0u;
+	bytes = MIN((frames - start) * 4u, 512u);
+	raw = (const uint8_t *)(stream_input + 2u * start);
+	for (uint32_t offset = 0; offset < bytes; offset += 64u) {
+		uint32_t count = MIN(64u, bytes - offset);
+
+		for (uint32_t i = 0; i < count; i++) {
+			hex[2u * i] = digits[raw[offset + i] >> 4];
+			hex[2u * i + 1u] = digits[raw[offset + i] & 15u];
+		}
+		hex[2u * count] = 0;
+		stream_log("SWEET HALSTREAM: raw frame=%u off=%u bytes=%u %s\n",
+		    start, offset, count, hex);
+	}
+}
+
+/*
+ * Called on BOTH GLINK completed-packet paths, before the control rsp slot.
+ * A matching data/basic packet is consumed here, even if malformed/stale.
+ */
+int
+sweet_audio_stream_rx(const uint8_t *packet, uint32_t bytes)
+{
+	uint32_t opcode, token;
+	int result;
+
+	if (!stream_active || packet == NULL || bytes < 24u) {
+		return 0;
+	}
+	opcode = stream_word(packet + 20);
+	token = stream_word(packet + 16);
+	if (opcode != 0x05001004u &&
+	    !(opcode == 0x02001005u && (token & 0x80000000u))) {
+		return 0;
+	}
+	if (opcode == 0x02001005u) {
+		uint32_t period = token & 3u;
+
+		if (bytes < 32u || (stream_word(packet) & 255u) != 0x60u ||
+		    (stream_word(packet) >> 8) != bytes ||
+		    stream_word(packet + 4) != 0x203u ||
+		    stream_word(packet + 8) != stream_queue.dst_port ||
+		    stream_word(packet + 12) != stream_queue.src_port ||
+		    stream_word(packet + 24) != 0x0400100au ||
+		    stream_queue.period[period].owner != MARBLE_PCM_INFLIGHT ||
+		    stream_queue.period[period].token != token) {
+			stream_queue.rejected++;
+			return 1;
+		}
+		stream_log("SWEET HALSTREAM: basic rsp token=%#x len=%u -> abort\n",
+		    token, bytes);
+		marble_pcm_abort(&stream_queue);
+		return 1; /* ACK/error is never a buffer ownership witness */
+	}
+	result = marble_pcm_done(&stream_queue, packet, bytes);
+	if (result == MARBLE_PCM_OK) {
+		if (stream_queue.completions <= 4u ||
+		    stream_queue.completions == MARBLE_PCM_MAX_SUBMISSIONS) {
+			stream_log("SWEET HALSTREAM: done=%u token=%#x attempted=%u\n",
+			    stream_queue.completions, token, stream_queue.submissions);
+		}
+	} else if (stream_queue.rejected <= 4u) {
+		stream_log("SWEET HALSTREAM: rejected result=%d token=%#x len=%u\n",
+		    result, token, bytes);
+	}
+	return 1;
+}
+
+static int
+stream_submit(uint32_t period, uint32_t frames,
+    const struct sweet_audio_stream_ops *ops)
+{
+	uint8_t packet[MARBLE_PCM_PACKET_BYTES];
+	uint32_t muted = sweet_audio_bridge_muted();
+	int result;
+
+	result = marble_pcm_stage(&stream_queue, period, stream_input, frames, muted != 0);
+	if (result != MARBLE_PCM_OK) {
+		return -1;
+	}
+	if (ops->store(period * MARBLE_PCM_BYTES,
+	    stream_queue.period[period].samples, MARBLE_PCM_BYTES) != 0) {
+		marble_pcm_abort(&stream_queue);
+		return -1;
+	}
+	result = marble_pcm_packet(&stream_queue, period, ops->now_us(), 1000000u, packet);
+	if (result != MARBLE_PCM_OK || ops->send(packet, sizeof(packet)) != 0) {
+		marble_pcm_abort(&stream_queue);
+		return -1;
+	}
+	stream_sent++;
+	if (stream_sent <= 4u || stream_sent == MARBLE_PCM_MAX_SUBMISSIONS) {
+		stream_log("SWEET HALSTREAM: sent=%u period=%u source=%llu peak-in=%u peak-out=%u\n",
+		    stream_sent, period, stream_queue.source_frames,
+		    stream_queue.peak_in, stream_queue.peak_out);
+	}
+	return 0;
+}
+
+int
+sweet_audio_stream_run(uint64_t base, uint32_t region, uint32_t handle,
+    uint32_t src, uint32_t dst, const struct sweet_audio_stream_ops *ops)
+{
+	uint32_t first_frames = 0;
+	int result = -1;
+
+	if (stream_once || ops == NULL || ops->now_us == NULL ||
+	    ops->wait_ms == NULL || ops->poll == NULL || ops->store == NULL ||
+	    ops->send == NULL ||
+	    marble_pcm_init(&stream_queue, base, region, 0x4000u, 856u,
+	    handle, src, dst, 1u) != MARBLE_PCM_OK) {
+		return -1;
+	}
+	stream_once = 1;
+	stream_active = 1;
+	stream_sent = 0;
+	stream_log("SWEET MARK: halstream v1 periods=4 bytes=4096 divisor=32 cap=30 amp=off\n");
+	stream_log("SWEET HALSTREAM: ready src=%#x dst=%#x handle=%#x base=%#llx wait-ms=120000\n",
+	    src, dst, handle, base);
+
+	/* A finite wait, not synthetic tone playback and not a raw timer spin. */
+	for (uint32_t attempt = 0; attempt < 12000u; attempt++) {
+		ops->poll();
+		first_frames = sweet_audio_bridge_consume(stream_input, MARBLE_PCM_FRAMES);
+		if (!sweet_audio_bridge_muted() &&
+		    stream_peak(stream_input, first_frames) >= 32u) {
+			stream_raw_witness(first_frames);
+			break;
+		}
+		first_frames = 0;
+		ops->wait_ms(10u);
+	}
+	if (first_frames == 0u) {
+		stream_log("SWEET HALSTREAM: no non-silent HAL frames before deadline\n");
+		goto out;
+	}
+	if (stream_submit(0, first_frames, ops) != 0) {
+		goto out;
+	}
+	for (uint32_t period = 1; period < MARBLE_PCM_PERIODS; period++) {
+		uint32_t frames = sweet_audio_bridge_consume(stream_input, MARBLE_PCM_FRAMES);
+
+		if (stream_submit(period, frames, ops) != 0) {
+			goto out;
+		}
+	}
+	for (uint32_t attempt = 0; attempt < 6000u; attempt++) {
+		ops->poll();
+		if (marble_pcm_expire(&stream_queue, ops->now_us()) != MARBLE_PCM_OK) {
+			break;
+		}
+		for (uint32_t period = 0; period < MARBLE_PCM_PERIODS; period++) {
+			if (stream_queue.submissions >= MARBLE_PCM_MAX_SUBMISSIONS) {
+				break;
+			}
+			if (stream_queue.period[period].owner == MARBLE_PCM_FREE) {
+				uint32_t frames = sweet_audio_bridge_consume(
+				    stream_input, MARBLE_PCM_FRAMES);
+
+				if (stream_submit(period, frames, ops) != 0) {
+					goto out;
+				}
+			}
+		}
+		if (stream_queue.completions == MARBLE_PCM_MAX_SUBMISSIONS &&
+		    stream_sent == MARBLE_PCM_MAX_SUBMISSIONS) {
+			result = 0;
+			break;
+		}
+		ops->wait_ms(2u);
+	}
+out:
+	stream_log("SWEET HALSTREAM: end result=%d attempted=%u sent=%u done=%u reject=%u fault=%u source=%llu silence=%llu peak-in=%u peak-out=%u\n",
+	    result, stream_queue.submissions, stream_sent, stream_queue.completions,
+	    stream_queue.rejected, stream_queue.fault,
+	    stream_queue.source_frames, stream_queue.silence_frames,
+	    stream_queue.peak_in, stream_queue.peak_out);
+	/* Remain active while caller STOP/CLOSE/UNMAP waits: isolate late DONE. */
+	return result;
+}
+
+void
+sweet_audio_stream_finish(void)
+{
+	stream_active = 0;
+	marble_pcm_abort(&stream_queue);
+	/* No restart and no DMA memory free here. */
+}
+
+int
+sweet_audio_stream_faulted(void)
+{
+	return stream_active && stream_queue.fault != 0;
+}
+
+void
+sweet_audio_stream_tick(uint64_t now_us)
+{
+	if (stream_active) {
+		(void)marble_pcm_expire(&stream_queue, now_us);
+	}
+}
+#endif
diff --git a/bsd/dev/sweet_audio_stream.h b/bsd/dev/sweet_audio_stream.h
new file mode 100644
index 0000000..56d5ec4
--- /dev/null
+++ b/bsd/dev/sweet_audio_stream.h
@@ -0,0 +1,26 @@
+#ifndef SWEET_AUDIO_STREAM_H
+#define SWEET_AUDIO_STREAM_H
+#include <sys/types.h>
+#include "sweet_audio_periods.h"
+
+/*
+ * The ADSP/GLINK thread alone runs these callbacks and the completion handler.
+ * Battery polling must remain disabled so no second consumer drains the FIFO.
+ */
+struct sweet_audio_stream_ops {
+	uint64_t (*now_us)(void);
+	void (*wait_ms)(uint32_t ms);
+	void (*poll)(void);
+	int (*store)(uint32_t offset, const int16_t *samples, uint32_t bytes);
+	int (*send)(const uint8_t *packet, uint32_t bytes);
+};
+
+int sweet_audio_stream_run(uint64_t base, uint32_t region, uint32_t handle,
+    uint32_t src, uint32_t dst, const struct sweet_audio_stream_ops *ops);
+int sweet_audio_stream_rx(const uint8_t *packet, uint32_t bytes);
+void sweet_audio_stream_finish(void);
+int sweet_audio_stream_faulted(void);
+void sweet_audio_stream_tick(uint64_t now_us);
+uint32_t sweet_audio_bridge_muted(void);
+
+#endif
