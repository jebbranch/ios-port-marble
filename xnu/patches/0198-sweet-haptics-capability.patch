+		}
+		error = vn_rdwr(UIO_WRITE, vp, (caddr_t)e->patched, e->len,
+		    (off_t)e->off, UIO_SYSSPACE, IO_SYNC, kauth_cred_get(),
+		    &resid, current_proc());
+		printf("SWEET CACHE: %s patched %s (%d resid %d)\n", e->what,
+		    error ? "FAILED" : "ok", error, resid);
 out:
-	vnode_close(vp, FWRITE, ctx);
-	vfs_context_rele(ctx);
