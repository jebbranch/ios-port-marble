-		    cur[0], cur[1], cur[2], cur[3]);
-		goto out;
-	}
-	error = vn_rdwr(UIO_WRITE, vp, (caddr_t)sweet_cache_ret, sizeof(cur),
-	    (off_t)SWEET_CACHE_PREWARM_OFF, UIO_SYSSPACE, IO_SYNC,
-	    kauth_cred_get(), &resid, current_proc());
-	printf("SWEET CACHE: portrait prewarm disabled %s (%d resid %d)\n",
-	    error ? "FAILED" : "ok", error, resid);
+		if (mode == 2) {
+			if (memcmp(cur, e->patched, e->len) != 0) {
+				printf("SWEET CACHE: %s restore skipped\n",
+				    e->what);
