+/*
+ * Multi-byte read (EXT_READL, BC = len-1).  The RTC time register at
+ * 0x6148 is a block register: the vendor's rtc-pm8xxx driver always reads
+ * four bytes at once, and single-byte reads of it are refused.
+ */
+int
+sweet_spmi_read_block(unsigned sid, unsigned addr, uint8_t *buf,
+    unsigned len)
+{
+	unsigned peripheral = addr >> 8;
 
+	if (!sp_ready || !buf || len < 1 || len > 4 || sid > 15 ||
+	    addr > 0xffffu || !(sid == 0 && peripheral == 0x61)) {
+		return -1;
+	}
+	IOLockLock(sp_lock);
+	uint16_t apid = sp_find_apid((sid << 8) | peripheral);
+	if (apid == SP_NO_APID || sp_poisoned[apid]) {
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+	unsigned off = sp_obs_stride * apid;
+	uint32_t cmd = (1u << 27) | ((addr & 0xffu) << 4) | (len - 1u);
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(sp_obs + off) = cmd;
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = sp_rd(sp_obs, off + 0x08u);
+		if (status & 1u) {
+			if (status & 0x0eu) {
+				printf("SWEET BATTERY: block read status=%#x\n",
+				    status);
+				IOLockUnlock(sp_lock);
+				return -1;
+			}
+			uint32_t word = sp_rd(sp_obs, off + 0x18u);
+			for (unsigned k = 0; k < len; k++) {
+				buf[k] = (uint8_t)(word >> (8 * k));
+			}
+			IOLockUnlock(sp_lock);
+			return 0;
+		}
+		delay(1);
+	}
+	sp_poisoned[apid] = true;
+	printf("SWEET BATTERY: block read timeout sid=%u addr=%#x\n",
+	    sid, addr);
+	IOLockUnlock(sp_lock);
+	return -1;
+}
