+			gh = gm_rd(gc, 0x93ecu);
+			b1 = gm_rd(gc, 0x911cu);
+			b2 = gm_rd(gc, 0x911cu);
+			printf("SWEET GMU: gap ahb=%x cxgmu=%x cmd=%x backtoback=%x %x\n",
+			    ga, gcm, gh, b1, b2);
