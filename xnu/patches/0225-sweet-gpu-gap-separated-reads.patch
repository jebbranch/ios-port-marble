+		 * So a trustworthy gpu_cc_ahb sample is one read per gap.  Take
+		 * three gapped reads, then one immediately-following pair as the
+		 * in-run control that the artifact is still there.
+		 */
+		{
+			uint32_t ga, gcm, gh, b1, b2;
+
+			g_wait(20);
