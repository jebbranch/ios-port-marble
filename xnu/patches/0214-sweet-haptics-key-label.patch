+/* Any dictionary key: symbol/string as text, everything else by class+bytes. */
+static const char *
+sweet_hap_key_label(OSObject *key)
+{
+	static char label[96];
+
+	if (key == NULL) {
+		return "?";
+	}
+	const OSSymbol *sym = OSDynamicCast(OSSymbol, key);
+	if (sym != NULL) {
+		return sym->getCStringNoCopy();
+	}
+	const OSString *str = OSDynamicCast(OSString, key);
+	if (str != NULL) {
+		return str->getCStringNoCopy();
+	}
+	const OSData *data = OSDynamicCast(OSData, key);
+	if (data != NULL) {
+		const uint8_t *p = (const uint8_t *)data->getBytesNoCopy();
+		uint32_t n = data->getLength();
+		uint32_t m = n > 8 ? 8 : n;
+		char *o = label;
+
+		o += snprintf(o, 32, "data:%u:", n);
+		for (uint32_t i = 0; i < m && o < label + sizeof(label) - 4; i++) {
+			o += snprintf(o, 3, "%02x", p[i]);
+		}
+		return label;
+	}
+	snprintf(label, sizeof(label), "<%s>", key->getMetaClass()->getClassName());
+	return label;
 }
 
+/* OSDictionary only offers OSSymbol / OSString / char* lookups here. */
+static OSObject *
+sweet_hap_get(OSDictionary *dict, OSObject *key)
+{
+	const OSSymbol *sym = OSDynamicCast(OSSymbol, key);
+	if (sym != NULL) {
+		return dict->getObject(sym);
+	}
+	const OSString *str = OSDynamicCast(OSString, key);
+	if (str != NULL) {
+		return dict->getObject(str);
+	}
+	return NULL;
+}
 
