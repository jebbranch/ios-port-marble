+/* Owner (write EE) of a PPID; 0xff when the PPID is not mapped. */
+static unsigned
+sp_ppid_owner(unsigned ppid)
+{
+	for (unsigned i = 0; i < sp_count; ++i) {
+		uint32_t map = sp_rd(sp_core, 0x2000u + 4u * i);
+		if (map && ((map >> 8) & 0xfffu) == ppid) {
+			return sp_rd(sp_cfg, 4u * i) & 7u;
+		}
+	}
+	return 0xffu;
 }
 
