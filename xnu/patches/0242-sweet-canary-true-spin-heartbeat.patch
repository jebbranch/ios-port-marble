 #define G_CANARY_SCRATCH_N (sizeof(g_canary_scratch) / sizeof(g_canary_scratch[0]))
 #define G_CANARY_TICK_US	   20000u	/* 20 ms; 100 ticks = 2 s window */
 
+/* NOTE: disable_preemption()/enable_preemption() are macros from
+ * <kern/cpu_data.h> (included above) expanding to _disable_preemption()/
+ * _enable_preemption().  The plain names have no linkable definition, so
+ * they must not be declared extern here (the extern form failed the
+ * link on the 2026-11-02 fork CI run).
+ */
+
+/*
+ * True spin on the virtual counter.  delay() and g_wait() block on a
+ * timer deadline in this port: cpu_idle_latency is 0, so
+ * ml_delay_should_spin() returns FALSE and both sleep instead of
+ * spinning.  A heartbeat paced by either one cannot tell "the machine
+ * stopped" from "no timer interrupt arrived" -- the exact ambiguity
+ * that retired the G3/G4 conclusions on 2026-11-02.  Spinning on
+ * CNTVCT_EL0 with preemption raised needs neither the scheduler nor
+ * interrupt delivery; the spin itself is zero MMIO and zero memory
+ * writes.  Only the pacing is spun: the prints between ticks still use
+ * the normal log path.
+ */
+static uint64_t
+g_cntvct(void)
+{
+	uint64_t v;
+
+	__asm__ volatile("mrs %0, cntvct_el0" : "=r" (v));
+	return v;
+}
+
+static void
+g_spin_us(uint64_t us)
+{
+	uint64_t freq, start, ticks;
+
+	__asm__ volatile("mrs %0, cntfrq_el0" : "=r" (freq));
+	if (freq == 0u) {
+		/* Period only; the exact rate is not load-bearing. */
+		freq = 62500000u;
+	}
+	start = g_cntvct();
+	ticks = (us * freq) / 1000000u;
+	disable_preemption();
+	while ((g_cntvct() - start) < ticks) {
+		__asm__ volatile("" ::: "memory");
+	}
+	enable_preemption();
+}
+
