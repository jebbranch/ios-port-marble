+		g_put32(pkt + 0, (6u << 4) | (sizeof(pkt) << 8));
+		g_put32(pkt + 4, GPR_DOMAIN_ADSP | (GPR_DOMAIN_APPS << 8));
+		g_put32(pkt + 8, src_port);
+		g_put32(pkt + 12, 1);
