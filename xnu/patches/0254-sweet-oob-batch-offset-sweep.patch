 	if (!g_shm_mapped || !g_shm_va) {
-		printf("SWEET MARK: oobcfg v1 no mapping\n");
+		printf("SWEET MARK: oobcfg v2 no mapping\n");
 		return (-1);
 	}
 	memset(body, 0, sizeof(body));
