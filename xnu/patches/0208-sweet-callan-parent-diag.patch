+class AppleHapticsSupportUserClient : public SweetHapticsUCBase {
+	OSDeclareDefaultStructors(AppleHapticsSupportUserClient);
+public:
+	virtual bool initWithTask(task_t owningTask, void *securityID, UInt32 type,
+	    OSDictionary *properties) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(AppleHapticsSupportUserClient, SweetHapticsUCBase);
+
+bool
+AppleHapticsSupportUserClient::initWithTask(task_t owningTask, void *securityID,
+    UInt32 type, OSDictionary *properties)
+{
+	bool entitled = false;
+
+	/*
+	 * 真机 UC 在 initWithTask 里要求
+	 * com.apple.ahs.userclientaccess == kOSBooleanTrue，否则直接失败。
+	 * 这里只记录不拒绝：先区分“系统没带 entitlement”与“带了但后续
+	 * selector 不匹配”，否则永远看不到后面的请求。
+	 * externalMethod 的 selector/参数/XML 记录由 SweetHapticsUCBase 完成。
+	 */
+	if (owningTask != NULL) {
+		OSSharedPtr<OSObject> ent = IOUserClient::copyClientEntitlement(
+		    owningTask, "com.apple.ahs.userclientaccess");
+
+		entitled = (ent == kOSBooleanTrue);
+	}
+	IOLog("SWEET HAPTICS: AHSUC initWithTask pid=%d type=%u "
+	    "entitlement=%s\n",
+	    owningTask != NULL ? task_pid(owningTask) : -1, (unsigned)type,
+	    entitled ? "present" : "absent");
+	return SweetHapticsUCBase::initWithTask(owningTask, securityID, type,
+	    properties);
+}
