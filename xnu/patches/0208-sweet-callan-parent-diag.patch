+static void
+sweet_ahs_log_chain(const IOService *svc, const char *what)
+{
+	char chain[192];
+	size_t used = 0;
+	const OSMetaClass *mc;
+
+	chain[0] = '\0';
+	if (svc != NULL) {
+		for (mc = svc->getMetaClass(); mc != NULL;
+		    mc = mc->getSuperClass()) {
+			const char *name = mc->getClassName();
+			size_t len = strlen(name);
+
+			if (used + len + 3 >= sizeof(chain)) {
+				break;
+			}
+			if (used != 0) {
+				chain[used++] = '<';
+				chain[used++] = '-';
+			}
+			memcpy(chain + used, name, len);
+			used += len;
+		}
+	}
+	chain[used] = '\0';
+	IOLog("SWEET HAPTICS: %s chain %s\n", what, chain);
+}
