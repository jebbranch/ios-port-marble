+/*
+ * Post-boot diagnostics.
+ *
+ * The kernel console goes quiet once the early daemons have started, so
+ * nothing printed after that reaches the SWEETLOG ring through _cnputs.
+ * sweet_log_append() feeds the same 1 s flusher directly, which keeps
+ * user-client and session events visible in the ring no matter when they
+ * happen.
+ */
+extern "C" void sweet_log_append(const char *c, int size);
+
+static void
+sweet_hap_ring_log(const char *fmt, ...)
+{
+	char line[256];
+	va_list ap;
+	int n;
+
+	va_start(ap, fmt);
+	n = vsnprintf(line, sizeof(line), fmt, ap);
+	va_end(ap);
+	if (n > 0) {
+		if (n > (int)sizeof(line) - 1) {
+			n = (int)sizeof(line) - 1;
+		}
+		sweet_log_append(line, n);
+	}
+}
+
+#define SWEET_HAP_LOG(fmt, ...) do { \
+	IOLog(fmt, ##__VA_ARGS__); \
+	sweet_hap_ring_log(fmt, ##__VA_ARGS__); \
+} while (0)
+
 /* The haptics buffer the client maps.  Retained for the lifetime of the
  * kernel so the close-time dump cannot touch freed memory. */
