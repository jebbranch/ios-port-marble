+
+/*
+ * Map the "chnls" slot for one APID on demand.  The whole window is 4 MiB
+ * and XNU's io_submap is only 8 MiB, so mapping it in one piece aborts with
+ * KERN_RESOURCE_SHORTAGE; a single 4 KiB page covers every register here.
+ */
+static vm_offset_t
+sp_chnl_slot(uint16_t apid, unsigned shift)
+{
+	if (sp_chnl && sp_chnl_apid == apid && sp_chnl_shift == shift) {
+		return sp_chnl;
+	}
+	vm_offset_t va = ml_io_map(SP_CHNL_PA + ((vm_offset_t)apid << shift),
+	    SP_CHNL_SLOT);
+	if (!va) {
+		printf("SWEET BATTERY: chnls map failed APID=%u shift=%u\n",
+		    apid, shift);
+		return 0;
+	}
+	sp_chnl = va;
+	sp_chnl_apid = apid;
+	sp_chnl_shift = shift;
+	return va;
 }
 
