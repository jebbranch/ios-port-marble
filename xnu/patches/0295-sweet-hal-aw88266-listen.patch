diff --git a/bsd/dev/sweet_i2c.c b/bsd/dev/sweet_i2c.c
index e3e9dbe..f90ffa1 100644
--- a/bsd/dev/sweet_i2c.c
+++ b/bsd/dev/sweet_i2c.c
@@ -771,6 +771,221 @@ se15_aw_init(uint8_t addr)
 	return bad ? -1 : 0;
 }
 
+#define AW_SYSST             0x01u
+#define AW_SYSCTRL           0x04u
+#define AW_I2SCTRL3          0x08u
+#define AW_PWDN              (1u << 0)
+#define AW_AMPPD             (1u << 1)
+#define AW_HMUTE             (1u << 8)
+#define AW_ULS_HMUTE         (1u << 14)
+#define AW_PLLS              (1u << 0)
+#define AW_CLKS              (1u << 4)
+#define AW_NOCLKS            (1u << 5)
+#define AW_WDS               (1u << 6)
+#define AW_OTHS              (1u << 1)
+#define AW_OCDS              (1u << 3)
+#define AW_BSTOCS            (1u << 11)
+#define AW_UVLS              (1u << 14)
+#define AW_OVP2S             (1u << 15)
+#define AW_FAULTS            (AW_NOCLKS | AW_WDS | AW_OTHS | AW_OCDS | \
+    AW_BSTOCS | AW_UVLS | AW_OVP2S)
+#define AW_PLL_OK            (AW_PLLS | AW_CLKS)
+
+static int listen_ready;
+static int listen_started;
+static uint16_t listen_i2sctrl3[2];
+
+static int
+se15_aw_ctrl(uint8_t addr, uint16_t set, uint16_t clear, uint16_t *after)
+{
+	uint16_t value;
+
+	if (se15_aw_read(addr, AW_SYSCTRL, &value) != 0) {
+		return -1;
+	}
+	value = (uint16_t)((value | set) & ~clear);
+	if (se15_aw_write(addr, AW_SYSCTRL, value) != 0 ||
+	    se15_aw_read(addr, AW_SYSCTRL, after) != 0 || *after != value) {
+		return -1;
+	}
+	return 0;
+}
+
+static void
+sweet_i2c_listen_powerdown(const char *why)
+{
+	static const uint8_t addrs[2] = { 0x34, 0x35 };
+	int failed = 0;
+
+	for (int i = 0; i < 2; i++) {
+		uint16_t value = 0;
+
+		if (se15_aw_ctrl(addrs[i],
+		    AW_HMUTE | AW_ULS_HMUTE, 0, &value) != 0) {
+			failed = 1;
+		}
+		if (listen_i2sctrl3[i] != 0) {
+			if (se15_aw_write(addrs[i], AW_I2SCTRL3,
+			    (uint16_t)(listen_i2sctrl3[i] & ~(1u << 6))) != 0) {
+				failed = 1;
+			}
+		}
+		if (se15_aw_ctrl(addrs[i],
+		    AW_PWDN | AW_AMPPD, 0, &value) != 0) {
+			failed = 1;
+		}
+		printf("SWEET LISTEN: powerdown %s addr=%#x ctrl=%#x\n",
+		    why, addrs[i], value);
+	}
+	if (failed) {
+		sw_gpio_drive(SW_AMP_RST_A_PA, false);
+		sw_gpio_drive(SW_AMP_RST_B_PA, false);
+		printf("SWEET LISTEN: powerdown I2C failed; both resets held low\n");
+	}
+	listen_started = 0;
+	sweet_log_sync();
+}
+
+static int
+se15_aw_init_safe(uint8_t addr, int index)
+{
+	unsigned n = sizeof(aw882xx_music_a) / sizeof(aw882xx_music_a[0]);
+
+	if (se15_aw_write(addr, 0x00, 0x55aa) != 0) {
+		return -1;
+	}
+	delay(2);
+	for (unsigned i = 0; i < n; i++) {
+		uint8_t reg = aw882xx_music_a[i].reg;
+		uint16_t value = aw882xx_music_a[i].val;
+
+		if (reg == AW_SYSCTRL) {
+			value |= AW_PWDN | AW_AMPPD | AW_HMUTE | AW_ULS_HMUTE;
+		} else if (reg == AW_I2SCTRL3) {
+			listen_i2sctrl3[index] = value;
+			value &= (uint16_t)~(1u << 6);
+		}
+		if (se15_aw_write(addr, reg, value) != 0) {
+			return -1;
+		}
+	}
+	{
+		uint16_t id = 0, ctrl = 0, volume = 0;
+
+		if (se15_aw_read(addr, 0x00, &id) != 0 || id != 0x2032 ||
+		    se15_aw_read(addr, AW_SYSCTRL, &ctrl) != 0 ||
+		    (ctrl & (AW_PWDN | AW_AMPPD | AW_HMUTE | AW_ULS_HMUTE)) !=
+		    (AW_PWDN | AW_AMPPD | AW_HMUTE | AW_ULS_HMUTE) ||
+		    se15_aw_read(addr, 0x05, &volume) != 0 || volume != 0x05a9) {
+			return -1;
+		}
+		printf("SWEET LISTEN: safe-profile addr=%#x id=%#x ctrl=%#x vol=%#x\n",
+		    addr, id, ctrl, volume);
+	}
+	return 0;
+}
+
+int
+sweet_i2c_listen_start(void)
+{
+	static const uint8_t addrs[2] = { 0x34, 0x35 };
+
+	if (listen_ready || listen_started) {
+		return -1;
+	}
+	if (!se15_init()) {
+		sw_gpio_drive(SW_AMP_RST_A_PA, false);
+		sw_gpio_drive(SW_AMP_RST_B_PA, false);
+		printf("SWEET LISTEN: SE15 init failed; both resets held low\n");
+		sweet_log_sync();
+		return -1;
+	}
+	/* GPIO52 low is the speaker path; high is the handset/earpiece path. */
+	sw_gpio_drive(SW_AMP_SPKSW_PA, false);
+	if (sw_gpio_read_level(SW_AMP_SPKSW_PA) != 0) {
+		sweet_i2c_listen_powerdown("speaker-switch-failed");
+		return -1;
+	}
+	printf("SWEET LISTEN: speaker-switch=0 (speaker, never handset)\n");
+	se15_tdm_pins();
+	for (int i = 0; i < 2; i++) {
+		if (se15_aw_init_safe(addrs[i], i) != 0) {
+			sweet_i2c_listen_powerdown("prepare-failed");
+			return -1;
+		}
+	}
+	listen_ready = 1;
+	/* Phase 1: both devices must see the bit clock before either can unmute. */
+	for (int i = 0; i < 2; i++) {
+		uint16_t ctrl = 0, status = 0;
+		int locked = 0;
+
+		if (se15_aw_ctrl(addrs[i], 0, AW_PWDN, &ctrl) != 0) {
+			goto fail;
+		}
+		delay(2000);
+		for (int tries = 0; tries < 10; tries++) {
+			if (se15_aw_read(addrs[i], AW_SYSST, &status) != 0) {
+				goto fail;
+			}
+			if ((status & AW_PLL_OK) == AW_PLL_OK &&
+			    (status & AW_FAULTS) == 0) {
+				locked = 1;
+				break;
+			}
+			delay(2000);
+		}
+		printf("SWEET LISTEN: pll addr=%#x status=%#x locked=%d\n",
+		    addrs[i], status, locked);
+		if (!locked) {
+			goto fail;
+		}
+	}
+	/* Phase 2: both output stages must report healthy while still muted. */
+	for (int i = 0; i < 2; i++) {
+		uint16_t ctrl = 0, status = 0;
+
+		if (se15_aw_ctrl(addrs[i], 0, AW_AMPPD, &ctrl) != 0) {
+			goto fail;
+		}
+		delay(1000);
+		if (se15_aw_read(addrs[i], AW_SYSST, &status) != 0 ||
+		    (status & AW_PLL_OK) != AW_PLL_OK || (status & AW_FAULTS) != 0) {
+			goto fail;
+		}
+		printf("SWEET LISTEN: healthy-muted addr=%#x status=%#x ctrl=%#x\n",
+		    addrs[i], status, ctrl);
+	}
+	/* Phase 3: only after both passed, restore I2S feedback and unmute both. */
+	for (int i = 0; i < 2; i++) {
+		uint16_t ctrl = 0, status = 0;
+
+		if (se15_aw_write(addrs[i], AW_I2SCTRL3, listen_i2sctrl3[i]) != 0 ||
+		    se15_aw_ctrl(addrs[i], 0, AW_ULS_HMUTE | AW_HMUTE, &ctrl) != 0 ||
+		    se15_aw_read(addrs[i], AW_SYSST, &status) != 0 ||
+		    (status & AW_PLL_OK) != AW_PLL_OK || (status & AW_FAULTS) != 0) {
+			goto fail;
+		}
+		printf("SWEET LISTEN: unmuted addr=%#x status=%#x ctrl=%#x\n",
+		    addrs[i], status, ctrl);
+	}
+	listen_started = 1;
+	printf("SWEET MARK: listen v1 started=1 peak-limit=16384 volume-reg=0x05a9\n");
+	sweet_log_sync();
+	return 0;
+fail:
+	sweet_i2c_listen_powerdown("start-failed");
+	return -1;
+}
+
+void
+sweet_i2c_listen_stop(void)
+{
+	sweet_i2c_listen_powerdown("normal-stop");
+	printf("SWEET MARK: listen v1 stopped=1\n");
+	sweet_log_sync();
+}
+
