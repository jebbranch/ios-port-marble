@@ -425,19 +429,27 @@
 		printf("SWEET I2C: se15 busy, not taken over\n");
 		return false;
 	}
+	printf("SWEET I2C: se15 cfg step 1\n");
+	sweet_log_sync();
 	se15_wr(0xe18, 0);              /* no GSI events */
 	se15_wr(0xe1c, 0);              /* poll local status */
 	se15_wr(0x644, 0);
 	se15_wr(SE_IRQ_CLR, 0xffffffffu);
 	se15_wr(0x648, 0xffffffffu);
+	printf("SWEET I2C: se15 cfg step 2\n");
+	sweet_log_sync();
 	se15_wr(SE_DMA, 0);
 	se15_wr(0x28, se15_rd(0x28) | 0x7fu);
 	se15_wr(0xe30, se15_rd(0xe30) | 0x0fu);
 	se15_wr(0x24, 0x7f);
 	se15_wr(0x20, 1);
+	printf("SWEET I2C: se15 cfg step 3\n");
+	sweet_log_sync();
 	se15_wr(SE_CLK_SEL, 0);
 	se15_wr(SE_MCLK, (7u << 4) | 1u);
 	se15_wr(SE_SCL, (10u << 20) | (11u << 10) | 26u); /* 100 kHz */
+	printf("SWEET I2C: se15 cfg step 4\n");
+	sweet_log_sync();
 	se15_wr(0x254, 0);
 	se15_wr(0x260, SE_PACK0);
 	se15_wr(0x264, SE_PACK1);
@@ -447,6 +459,8 @@
 	se15_wr(0x810, 0);
 	se15_wr(0x814, ((rx >> 16) & 0x3fu) - 1u);
 	se15_wr(SE_IRQ_EN, SE_EVENTS);
