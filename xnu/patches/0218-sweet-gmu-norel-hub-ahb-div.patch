 		gm_wr(gc, 0x9148u, gm_rd(gc, 0x9148u) | 1u);	/* hub_cx_int */
 		gm_wr(gc, 0x913cu, gm_rd(gc, 0x913cu) | 1u);	/* cx_gmu */
