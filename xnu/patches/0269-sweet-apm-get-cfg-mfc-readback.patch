 }
 
+/*
+ * 0269: read one parameter back from one module - APM_CMD_GET_CFG.
+ *
+ * Why this exists: every reading so far about the MFC was indirect.  H1 proved
+ * removing our three invented TDM params changes nothing, the vendor's own
+ * traffic never names our MFC instance 0x48ba, and the ear said "silent" at the
+ * clamp maximum - none of that says what rate the MFC is actually emitting.
+ * The public MFC get_param returns out_media_fmt[port].format, i.e. the module's
+ * real current output format rather than an echo of whatever we last sent, so a
+ * single GET distinguishes "still Native at 48 kHz" from "already 96 kHz".
+ *
+ * g_apm_cmd() parses every reply as a basic response, so on this opcode the
+ * "status=" it prints is really the echoed instance id - the dump below is the
+ * authority, and it prints the raw word window so nothing about the reply
+ * layout is assumed.  Expected public layout after the 24-byte GPR header:
+ *   w6 status | w7 iid | w8 param | w9 param_size | w10 error_code | w11 data
+ * which puts sampling_rate at absolute +44 (w11) for param 0x08001024.
+ */
+static void
+g_apm_get_cfg_dump(uint32_t src_port, uint32_t iid, uint32_t pid,
+    uint32_t bufsize, const char *phase)
+{
+	uint8_t pl[16 + 72];
+	uint32_t plen;
+	uint32_t bs = bufsize > 72 ? 72 : bufsize;
+
+	memset(pl, 0, sizeof(pl));
+	g_put32(pl + 0, iid);
+	g_put32(pl + 4, pid);
+	g_put32(pl + 8, bs);	/* capacity we offer, not a payload length */
+	plen = (16 + bs + 7u) & ~7u;
+	(void)g_apm_cmd(src_port, iid, pl, plen, APM_CMD_GET_CFG, "get_cfg");
+
+	printf("SWEET MARK: mfcget v1 %s raw:", phase);
+	if (g_rsp_ready) {
+		for (uint32_t k = 5; k < 14 && (k + 1) * 4 <= g_rsp_len; k++) {
+			printf(" w%u=%#x", k, g_le32(g_rsp + k * 4));
+		}
+		printf(" len=%u\n", g_rsp_len);
+	} else {
+		printf(" no response\n");
+	}
+	sweet_log_sync();
+}
