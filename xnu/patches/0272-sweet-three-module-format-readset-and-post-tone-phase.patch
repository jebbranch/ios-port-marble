+/*
+ * 0272: the three-module read set, sent read-only in graph order.
+ *
+ * J1 (boot 37) closed the "is the MFC fed" question with the port's first
+ * positive mechanism reading - rate=-1, num_channels=0xFFFF at pre-set,
+ * post-prepare AND post-start - while every SET_CFG, GRAPH_OPEN, PREPARE, START
+ * and 120 DATA_BUFFERs came back accepted.  One invalid module on a five-module
+ * chain is still three explanations wide: the WR endpoint never published a
+ * format (so the propagation had nothing to hand on), the propagation ran and
+ * dropped it before the TDM sink, or the whole chain is fine and only the
+ * converter's own output default is never overwritten.  Reading the three
+ * modules we do have parameter bodies for separates them in one boot:
+ *   0x40bd WR_SHARED_MEM_EP  PARAM_ID_MEDIA_FORMAT           0x0800100c (30 B sent)
+ *   0x428f TDM_SINK          PARAM_ID_HW_EP_MF_CFG           0x08001017 (12 B sent)
+ *   0x48ba MFC               PARAM_ID_MFC_OUTPUT_MEDIA_FORMAT 0x08001024 (12 B sent)
+ * (the three names are PARAM_ID_* defines in
+ * work/sweet-audio/refs/qdsp6/ko-sound_soc_qcom_qdsp6_audioreach.h:283/626/730;
+ * the driver itself keeps using the literal ids it already sends.)
+ * The iids come from g_graph_vp_wr's own module/connection tables; the params
+ * are the ones g_audio_graph_cfg_vp() actually writes to those instances, so no
+ * new parameter id is introduced here - only the direction of the traffic.
+ *
+ * sweetmfcget: 0 nothing (default, shipped sequence unchanged) | 1 read the MFC
+ * around the sweetmfc set | 2 + post-prepare + post-start | 3 = this read set at
+ * post-start and again after the tone, on top of 1's pre-set and 2's
+ * post-prepare MFC reads.  A GET is answered or not; nothing here changes what
+ * the graph is told.
+ */
+static void
+g_apm_get_cfg_readset(uint32_t src_port, const char *phase)
+{
+	g_apm_get_cfg_dump(src_port, G_VP_WR_IID, 0x0800100cu, 72, phase);
+	g_apm_get_cfg_dump(src_port, G_VP_TDM_IID, 0x08001017u, 72, phase);
+	g_apm_get_cfg_dump(src_port, G_VP_MFC_IID, 0x08001024u, 72, phase);
+}
