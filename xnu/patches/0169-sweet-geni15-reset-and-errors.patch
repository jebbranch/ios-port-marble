+
+/* Give both amps a defined reset edge, then log every control pad so a dead
+ * rail or a stuck reset is visible before the first transfer. */
+static void
+se15_amp_pins(void)
+{
+	static const uint32_t rst[2] = { 0x0f101000u, 0x0f178000u };
+	static const uint32_t aux[2] = { 0x0f134000u, 0x0f158000u };
+
+	for (int i = 0; i < 2; i++) {
+		sw_gpio_drive(rst[i], false);
+		delay(2);
+		sw_gpio_drive(rst[i], true);
+	}
+	delay(10);
+	printf("SWEET I2C: rstA=%d rstB=%d spksw=%d irq=%d\n",
+	    sw_gpio_read_level(rst[0]), sw_gpio_read_level(rst[1]),
+	    sw_gpio_read_level(aux[0]), sw_gpio_read_level(aux[1]));
 	sweet_log_sync();
 }
 
