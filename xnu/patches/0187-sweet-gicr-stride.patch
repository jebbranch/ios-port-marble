 		}
 
 		gicr_size = gicr_size_prop;
+
+		/*
+		 * Marble's GIC-500 redistributors are 0x40000 apart, not the GICv3
+		 * default 0x20000.  QEMU virt keeps the default, so this is a boot
+		 * arg rather than a compile-time change.  cpus=1 never needed it:
+		 * CPU0 always uses frame 0.
+		 */
+		uint64_t stride = 0;
+		if (PE_parse_boot_argn("gicrstride", &stride, sizeof(stride)) &&
+		    stride >= 0x10000) {
+			gicr_pe_size = (vm_offset_t)stride;
+			kprintf("SWEET GIC: GICR stride %#llx\n",
+			    (unsigned long long)stride);
+		}
