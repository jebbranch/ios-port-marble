+
+/*
+ * AppleAOPAudioButtonHapticDevice /
+ * AppleAOPButtonHapticsServiceUserClient.
+ *
+ * The real AppleAOPAudio kext publishes this provider from the
+ * audio-aop-bhap device-node personality.  backboardd opens its user client
+ * for button and system haptics, so expose the same class and selector-log
+ * interface directly from IOResources.
+ */
+class AppleAOPButtonHapticsServiceUserClient : public SweetHapticsUCBase {
+	OSDeclareDefaultStructors(AppleAOPButtonHapticsServiceUserClient);
+};
+OSDefineMetaClassAndStructors(AppleAOPButtonHapticsServiceUserClient,
+    SweetHapticsUCBase);
+
+class AppleAOPAudioButtonHapticDevice : public IOService {
+	OSDeclareDefaultStructors(AppleAOPAudioButtonHapticDevice);
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(AppleAOPAudioButtonHapticDevice, IOService);
+
+bool
+AppleAOPAudioButtonHapticDevice::start(IOService *provider)
+{
+	OSArray *match;
+
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty("IOClass", "AppleAOPAudioButtonHapticDevice");
+	setProperty("IOUserClientClass",
+	    "AppleAOPButtonHapticsServiceUserClient");
+	setProperty("IOMatchCategory", "IODefaultMatchCategory");
+	setProperty("CFBundleIdentifier", "com.apple.driver.AppleAOPAudio");
+	setProperty("CFBundleIdentifierKernel",
+	    "com.apple.driver.AppleAOPAudio");
+	setProperty("compatible", "audio-aop-bhap");
+	setProperty("device_type", "audio-aop-bhap");
+	setProperty("id0", "bhap");
+	setProperty("Button Haptics Asset Interface", 1, 32);
+	match = OSArray::withCapacity(2);
+	if (match != NULL) {
+		OSString *s1 = OSString::withCString("audio-aop-bhap");
+		OSString *s2 = OSString::withCString("audio-bhap");
+		if (s1 != NULL) {
+			match->setObject(s1);
+			s1->release();
+		}
+		if (s2 != NULL) {
+			match->setObject(s2);
+			s2->release();
+		}
+		setProperty("IONameMatch", match);
+		match->release();
+	}
+	registerService();
+	IOLog("SWEET HAPTICS: AppleAOPAudioButtonHapticDevice registered\n");
+	return true;
 }
 
